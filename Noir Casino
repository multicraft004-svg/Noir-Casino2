function startCrash(stake, refs){
  if(stake <= 0){ toast('Введите ставку', 'lose'); return; }
  if(stake > state.balance){ toast('Недостаточно средств', 'lose'); return; }

  state.balance -= stake;
  saveState();

  // Определяем точку краша заранее (честная случайная модель с house edge)
  // Формула: crashPoint = 1 / (1 - r * houseEdgeFactor), r равномерно из (0,1)
  const talentBonuses = getTalentBonuses();
  const houseEdge = Math.max(0.02, 0.08 - talentBonuses.luckBonus); // базовые 8%, снижается талантами
  const r = Math.random();
  let crashPoint = (1 - houseEdge) / (1 - r);
  crashPoint = Math.max(1.00, Math.min(crashPoint, 50)); // cap at 50x for demo sanity
  crashPoint = Math.round(crashPoint * 100) / 100;

  const isAuto = refs.autoMode ? refs.autoMode() : false;
  const target = refs.autoTarget ? refs.autoTarget() : null;

  crashState = {
    stake, crashPoint, current: 1.00, cashedOut: false, exploded: false, refs, startTs: performance.now(),
    isAuto, autoTarget: target
  };

  refs.startBtn.style.display = 'none';
  refs.cashoutBtn.style.display = 'flex';
  refs.resultEl.textContent = '';
  refs.resultEl.className = 'crash-result';
  refs.rocket.classList.add('flying');
  refs.track.classList.remove('exploded');

  requestAnimationFrame(tickCrash);
}

function tickCrash(ts){
  if(!crashState || crashState.cashedOut || crashState.exploded) return;
  const elapsed = (ts - crashState.startTs) / 1000;
  // Экспоненциальный рост множителя
  const mult = Math.pow(Math.E, 0.17 * elapsed);
  crashState.current = mult;

  const { multEl, rocket, track, cashoutBtn } = crashState.refs;
  multEl.textContent = mult.toFixed(2) + 'x';
  cashoutBtn.textContent = `💰 Забрать x${mult.toFixed(2)}`;

  // Двигаем ракету
  const progress = Math.min(1, elapsed / 6);
  rocket.style.transform = `translate(${progress*70}%, ${-progress*60}%) rotate(${-8 + progress*-14}deg)`;

  if(mult >= crashState.crashPoint){
    explodeCrash();
    return;
  }

  // Автозабор — если включён режим "Авто" и множитель достиг заданной цели
  if(crashState.isAuto && mult >= crashState.autoTarget){
    cashoutCrash();
    return;
  }

  // Цвет по мере роста риска
  if(mult > 3) multEl.style.color = 'var(--crimson)';
  else if(mult > 1.8) multEl.style.color = 'var(--gold-bright)';
  else multEl.style.color = 'var(--emerald)';

  requestAnimationFrame(tickCrash);
}

function pushCrashHistory(point){
  crashHistory.unshift(point);
  if(crashHistory.length > 15) crashHistory.length = 15;
  const holder = document.getElementById('crashHistoryHolder');
  if(holder){
    holder.innerHTML = '';
    holder.appendChild(renderCrashHistoryStrip());
  }
}

function explodeCrash(){
  if(!crashState) return;
  crashState.exploded = true;
  const { rocket, track, startBtn, cashoutBtn, resultEl, multEl, groupList, getGroupParticipants } = crashState.refs;
  rocket.classList.remove('flying');
  track.classList.add('exploded');
  multEl.style.color = 'var(--crimson)';
  vibrate([40,30,60]);

  recordBet('crash', crashState.stake, 0);
  pushCrashHistory(crashState.crashPoint);
  resultEl.className = 'crash-result lose';
  resultEl.textContent = `💥 Взрыв на x${crashState.crashPoint.toFixed(2)}! Проигрыш ${formatNum(crashState.stake)} ₲`;

  if(groupList && getGroupParticipants){
    resolveCrashGroupParticipants(groupList, getGroupParticipants(), crashState.crashPoint);
  }

  cashoutBtn.style.display = 'none';
  startBtn.style.display = 'flex';
  startBtn.textContent = '🚀 Ещё раз';
  crashState = null;
}

function cashoutCrash(){
  if(!crashState || crashState.exploded || crashState.cashedOut) return;
  crashState.cashedOut = true;
  const mult = crashState.current;
  crashState.cashedOutMult = mult;
  const payout = crashState.stake * mult;

  const { cashoutBtn, resultEl } = crashState.refs;
  vibrate(25);

  recordBet('crash', crashState.stake, payout);
  resultEl.className = 'crash-result win';
  resultEl.textContent = `✅ Забрано на x${mult.toFixed(2)}! Выигрыш +${formatNum(payout - crashState.stake)} ₲ · летит дальше…`;

  cashoutBtn.style.display = 'none';
  // Ракета продолжает лететь "призрачно" до реальной точки краша — игрок увидит, докуда могло долететь
  requestAnimationFrame(tickCrashGhost);
}

function tickCrashGhost(ts){
  if(!crashState || crashState.exploded) return;
  if(!crashState.ghostStartTs) crashState.ghostStartTs = ts;
  const elapsedTotal = (ts - crashState.startTs) / 1000;
  const mult = Math.pow(Math.E, 0.17 * elapsedTotal);
  crashState.current = mult;

  const { multEl, rocket } = crashState.refs;
  multEl.textContent = mult.toFixed(2) + 'x';
  const progress = Math.min(1, elapsedTotal / 6);
  rocket.style.transform = `translate(${progress*70}%, ${-progress*60}%) rotate(${-8 + progress*-14}deg)`;

  if(mult > 3) multEl.style.color = 'var(--crimson)';
  else if(mult > 1.8) multEl.style.color = 'var(--gold-bright)';

  if(mult >= crashState.crashPoint){
    finishCrashAfterCashout();
    return;
  }
  requestAnimationFrame(tickCrashGhost);
}

function finishCrashAfterCashout(){
  const { rocket, track, startBtn, resultEl, groupList, getGroupParticipants } = crashState.refs;
  rocket.classList.remove('flying');
  track.classList.add('exploded');
  vibrate(15);

  pushCrashHistory(crashState.crashPoint);

  resultEl.innerHTML = '';
  resultEl.className = 'crash-result win';
  resultEl.appendChild(el('div', {}, [`✅ Забрано на x${crashState.cashedOutMult ? crashState.cashedOutMult.toFixed(2) : crashState.current.toFixed(2)}x`]));
  resultEl.appendChild(el('div', {class:'crash-ghost-line'}, [
    `👻 Ракета долетела бы до x${crashState.crashPoint.toFixed(2)} — если бы забрал позже, получил бы больше`
  ]));

  if(groupList && getGroupParticipants){
    resolveCrashGroupParticipants(groupList, getGroupParticipants(), crashState.crashPoint);
  }

  startBtn.style.display = 'flex';
  startBtn.textContent = '🚀 Ещё раз';
  crashState = null;
}

