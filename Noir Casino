  const body = el('div', {class:'game-body'});
  body.appendChild(el('div', {class:'odds-badge'}, ['🎯 Красное/чёрное x2 (RTP ~97%) · Зелёное (0) x34 (RTP ~92%)']));

  const wheelOuter = el('div', {class:'roulette-wheel-outer'});
  const wheelTrack = el('div', {class:'roulette-track', id:'rouletteTrack'});
  ROULETTE_NUMBERS.concat(ROULETTE_NUMBERS).concat(ROULETTE_NUMBERS).forEach(item=>{
