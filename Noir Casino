/* =========================================================
   ЕЖЕДНЕВНЫЙ БОНУС
   7-дневный цикл с растущими наградами. Пропуск дня сбрасывает стрик.
   ========================================================= */
const DAILY_BONUS_REWARDS = [200, 350, 500, 700, 950, 1300, 2000]; // день 1..7

function canClaimDailyBonus(){
  return state.dailyBonusLastClaimDate !== todayKey();
}

function getDailyBonusStreakDay(){
  // Какой день цикла будет засчитан, если забрать бонус СЕЙЧАС
  if(state.dailyBonusLastClaimDate === dateKeyForOffset(1)){
    // забирал вчера - стрик продолжается, следующий день (цикл 1-7)
    return (state.dailyBonusStreak % 7) + 1;
  }
  // пропустил день или первый раз - стрик начинается заново
  return 1;
}

function claimDailyBonus(){
  if(!canClaimDailyBonus()) return false;
  const day = getDailyBonusStreakDay();
  const reward = DAILY_BONUS_REWARDS[day - 1];
  state.balance += reward;
  state.dailyBonusStreak = day;
  state.dailyBonusLastClaimDate = todayKey();
  saveState();
  toast(`+${formatNum(reward)} ₲ — день ${day} бонуса!`, 'win');
  return true;
}

