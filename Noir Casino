<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>NOIR — Демо-казино</title>
<style>
  @font-face {
    font-family: 'DigitFace';
    src: local('Arial');
  }

  :root{
    --bg-deep: #0d0710;
    --bg-panel: #16101d;
    --bg-panel2: #1e1526;
    --bg-card: #241a2e;
    --line: rgba(255,255,255,0.07);
    --line-strong: rgba(255,255,255,0.14);
    --gold: #e8b84b;
    --gold-bright: #ffd873;
    --violet: #9b6bff;
    --violet-bright: #b48bff;
    --crimson: #ef4d6b;
    --emerald: #3ecf8e;
    --text-hi: #f3ecf7;
    --text-mid: #b6a9c4;
    --text-low: #7c6f8a;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
    --safe-top: env(safe-area-inset-top, 0px);
  }

  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color: transparent; }

  html, body{
    height:100%;
    overscroll-behavior:none;
  }

  body{
    background: radial-gradient(1200px 800px at 50% -10%, #241733 0%, var(--bg-deep) 55%), var(--bg-deep);
    color: var(--text-hi);
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
    min-height:100vh;
    overflow-x:hidden;
    user-select:none;
  }

  .app{
    max-width: 480px;
    margin: 0 auto;
    min-height:100vh;
    position:relative;
    display:flex;
    flex-direction:column;
  }

  /* ============ TOP BAR ============ */
  .topbar{
    position:sticky;
    top:0;
    z-index:40;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: calc(14px + var(--safe-top)) 16px 12px;
    background: linear-gradient(180deg, rgba(13,7,16,0.97) 60%, rgba(13,7,16,0.85));
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .brand{
    display:flex;
    align-items:center;
    gap:8px;
  }
  .brand-mark{
    width:30px; height:30px;
    border-radius:9px;
    background: linear-gradient(145deg, var(--violet-bright), var(--violet) 60%, #5a35a8);
    display:flex; align-items:center; justify-content:center;
    font-size:16px;
    box-shadow: 0 3px 10px rgba(155,107,255,0.35);
  }
  .brand-text{
    font-family: Georgia, 'Times New Roman', serif;
    font-weight:700;
    font-size:18px;
    letter-spacing:1.5px;
    background: linear-gradient(135deg, var(--gold-bright), var(--gold) 70%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }

  .balance-chip{
    display:flex;
    align-items:center;
    gap:7px;
    background: linear-gradient(145deg, var(--bg-card), var(--bg-panel2));
    border: 1px solid var(--line-strong);
    padding: 7px 12px 7px 8px;
    border-radius: 100px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    cursor:pointer;
    transition: transform .15s ease;
  }
  .balance-chip:active{ transform: scale(0.96); }
  .balance-coin{
    width:20px; height:20px;
    border-radius:50%;
    background: radial-gradient(circle at 35% 30%, var(--gold-bright), var(--gold) 55%, #a97a1e 100%);
    display:flex; align-items:center; justify-content:center;
    font-size:11px;
    box-shadow: 0 0 8px rgba(232,184,75,0.5);
    flex-shrink:0;
  }
  .balance-num{
    font-variant-numeric: tabular-nums;
    font-weight:700;
    font-size:14.5px;
    letter-spacing:0.3px;
    color: var(--gold-bright);
  }

  /* ============ SCREENS ============ */
  .screens{
    flex:1;
    position:relative;
    padding-bottom: calc(78px + var(--safe-bottom));
  }
  .screen{
    display:none;
    animation: fadeSlideIn .28s ease;
  }
  .screen.active{ display:block; }

  @keyframes fadeSlideIn{
    from{ opacity:0; transform: translateY(10px); }
    to{ opacity:1; transform: translateY(0); }
  }

  /* ============ BOTTOM NAV ============ */
  .bottomnav{
    position:fixed;
    left:0; right:0; bottom:0;
    max-width:480px;
    margin:0 auto;
    z-index:50;
    display:flex;
    background: linear-gradient(180deg, rgba(22,16,29,0.9), rgba(13,7,16,0.99) 40%);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    padding: 9px 6px calc(9px + var(--safe-bottom));
  }
  .navbtn{
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:3px;
    background:none;
    border:none;
    color: var(--text-low);
    font-family:inherit;
    font-size:10.5px;
    font-weight:600;
    letter-spacing:0.2px;
    padding:7px 4px 5px;
    border-radius:12px;
    transition: color .2s ease, background .2s ease;
  }
  .navbtn .navicon{
    font-size:19px;
    line-height:1;
    filter: grayscale(1) opacity(0.6);
    transition: filter .2s ease, transform .15s ease;
  }
  .navbtn.active{ color: var(--gold-bright); background: rgba(232,184,75,0.08); }
  .navbtn.active .navicon{ filter: grayscale(0) opacity(1); transform: translateY(-1px); }
  .navbtn:active .navicon{ transform: scale(0.88); }

  /* ============ SHARED ============ */
  .pad{ padding: 16px; }
  .section-title{
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:1.3px;
    color: var(--text-low);
    margin: 22px 0 12px;
  }
  .section-title:first-child{ margin-top:4px; }

  .card{
    background: linear-gradient(160deg, var(--bg-panel2), var(--bg-panel));
    border: 1px solid var(--line);
    border-radius:18px;
    padding:16px;
  }

  .btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    border:none;
    border-radius:15px;
    font-family:inherit;
    font-weight:700;
    font-size:16px;
    letter-spacing:0.2px;
    padding:16px 20px;
    cursor:pointer;
    transition: transform .12s ease, filter .15s ease, box-shadow .15s ease;
    -webkit-user-select:none;
  }
  .btn:active{ transform: scale(0.965); filter:brightness(0.94); }
  .btn:disabled{ opacity:0.4; pointer-events:none; }
  .btn-primary{
    background: linear-gradient(135deg, var(--gold-bright), var(--gold) 65%, #c9922a);
    color: #2a1a05;
    box-shadow: 0 6px 18px rgba(232,184,75,0.28);
  }
  .btn-violet{
    background: linear-gradient(135deg, var(--violet-bright), var(--violet) 70%);
    color:#fff;
    box-shadow: 0 6px 18px rgba(155,107,255,0.28);
  }
  .btn-ghost{
    background: var(--bg-card);
    border: 1px solid var(--line-strong);
    color: var(--text-hi);
  }
  .btn-danger{
    background: linear-gradient(135deg, #ff6b85, var(--crimson) 70%);
    color:#fff;
  }
  .btn-sm{ padding:10px 14px; font-size:13.5px; border-radius:11px; }
  .btn-block{ width:100%; }

  .field{
    background: var(--bg-card);
    border: 1.5px solid var(--line-strong);
    border-radius:14px;
    padding: 15px 16px;
    color: var(--text-hi);
    font-family:inherit;
    font-size:16px;
    font-weight:600;
    width:100%;
    transition: border-color .15s ease;
  }
  .field:focus{ outline:none; border-color: var(--violet); }
  .field::placeholder{ color: var(--text-low); font-weight:500; }

  .stake-row{
    display:flex;
    gap:8px;
    align-items:center;
  }
  .stake-row .field{ flex:1; text-align:center; font-variant-numeric: tabular-nums; }
  .stepbtn{
    width:48px; height:48px;
    border-radius:12px;
    background: var(--bg-card);
    border:1.5px solid var(--line-strong);
    color: var(--text-hi);
    font-size:21px;
    font-weight:700;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .stepbtn:active{ transform: scale(0.9); background: var(--bg-panel2); }

  .chip-row{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
    margin-top:9px;
  }
  .chip{
    background: var(--bg-card);
    border:1px solid var(--line-strong);
    color: var(--text-mid);
    font-size:12.5px;
    font-weight:700;
    padding:7px 13px;
    border-radius:100px;
  }
  .chip:active{ transform: scale(0.92); background: var(--bg-panel2); }

  ::-webkit-scrollbar{ display:none; }
</style>
</head>
<body>
<div class="app" id="app">

  <div class="topbar">
    <div class="brand">
      <div class="brand-mark">♠</div>
      <div class="brand-text">NOIR</div>
    </div>
    <div class="balance-chip" onclick="go('wallet')">
      <div class="balance-coin">₲</div>
      <div class="balance-num" id="topBalance">0</div>
    </div>
  </div>

  <div class="screens" id="screens"></div>

  <div class="bottomnav" id="bottomnav">
    <button class="navbtn active" data-tab="games" onclick="go('games')">
      <span class="navicon">🎰</span><span>Игры</span>
    </button>
    <button class="navbtn" data-tab="wallet" onclick="go('wallet')">
      <span class="navicon">💳</span><span>Кошелёк</span>
    </button>
    <button class="navbtn" data-tab="missions" onclick="go('missions')">
      <span class="navicon">📋</span><span>Задания</span>
    </button>
    <button class="navbtn" data-tab="profile" onclick="go('profile')">
      <span class="navicon">👤</span><span>Профиль</span>
    </button>
    <button class="navbtn" data-tab="top" onclick="go('top')">
      <span class="navicon">🏆</span><span>Топ</span>
    </button>
  </div>

</div>
<script>
/* =========================================================
   NOIR — демо-казино (виртуальная валюта, без реального вывода)
   ========================================================= */

const STORAGE_KEY = 'noir_casino_state_v1';

const DEFAULT_STATE = {
  balance: 1000000,
  totalWagered: 0,
  totalWon: 0,
  totalLost: 0,
  gamesPlayed: 0,
  bestWin: 0,
  nickname: 'Игрок',
  usedPromoCodes: [],
  history: [], // {game, stake, result, delta, ts}
  createdAt: Date.now(),
  cashback: 0,
  dailyTopupUsed: 0,
  dailyTopupDate: null,
  talentPoints: 0,
  unlockedTalents: [], // массив id открытых талантов
  talentPointsAwardedAtWager: 0, // сколько totalWagered уже учтено для начисления очков
  winsCount: 0,
  playedGamesSet: [], // список уникальных игр, в которые сыграл хотя бы раз
  claimedMissions: [], // id выполненных и полученных миссий
  perGameStats: {}, // {crash: {played, wins, wagered, won}, tower: {...}, ...}
  soundEnabled: true,
  vibrationEnabled: true,
  fakeLeaders: null, // персистентный список демо-лидеров, инициализируется при первом запуске
  onlineCount: null, // персистентный счётчик "играют сейчас"
  lastLeaderTickTs: null,
  lastOnlineTickTs: null,
  dailyBonusStreak: 0,
  dailyBonusLastClaimDate: null,
  claimedAchievements: [],
  investmentLastCollectTs: null,
  currentWinStreak: 0,
  bestWinStreak: 0,
  demoMode: false
};

const DAILY_TOPUP_LIMIT = 5000;

let state = loadState();

function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return structuredClone(DEFAULT_STATE);
    const parsed = JSON.parse(raw);
    return Object.assign(structuredClone(DEFAULT_STATE), parsed);
  }catch(e){
    return structuredClone(DEFAULT_STATE);
  }
}

function saveState(){
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  renderBalance();
}

/* =========================================================
   ДЕМО-РЕЖИМ
   Временно подменяет прогресс на резервный демо-набор, ничего не меняя
   в самих играх - все они как и раньше просто читают/пишут state.balance
   и другие поля напрямую. При выходе реальный прогресс восстанавливается
   из резервной копии как есть.
   ========================================================= */
const DEMO_BALANCE = 20000000000000;
const DEMO_BACKUP_FIELDS = [
  'balance','totalWagered','totalWon','totalLost','gamesPlayed','bestWin',
  'winsCount','perGameStats','cashback','currentWinStreak','bestWinStreak',
  'talentPoints','talentPointsAwardedAtWager','playedGamesSet','history'
];

function enterDemoMode(){
  if(state.demoMode) return;
  state._demoBackup = {};
  DEMO_BACKUP_FIELDS.forEach(f=>{ state._demoBackup[f] = structuredClone(state[f]); });
  state.balance = DEMO_BALANCE;
  state.totalWagered = 0;
  state.totalWon = 0;
  state.totalLost = 0;
  state.gamesPlayed = 0;
  state.bestWin = 0;
  state.winsCount = 0;
  state.perGameStats = {};
  state.cashback = 0;
  state.currentWinStreak = 0;
  state.bestWinStreak = 0;
  state.playedGamesSet = [];
  state.history = [];
  state.demoMode = true;
  saveState();
  toast('🎮 Демо-режим включён — ставки не настоящие', 'info');
}

function exitDemoMode(){
  if(!state.demoMode || !state._demoBackup) return;
  DEMO_BACKUP_FIELDS.forEach(f=>{ state[f] = state._demoBackup[f]; });
  delete state._demoBackup;
  state.demoMode = false;
  saveState();
  toast('Демо-режим выключен — вернулся реальный баланс', 'info');
}

function todayKey(){
  const d = new Date();
  return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
}

function dateKeyForOffset(daysAgo){
  const d = new Date();
  d.setDate(d.getDate() - daysAgo);
  return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
}

const VIP_WAGER_THRESHOLD = 50000; // общий оборот ставок для получения VIP-статуса
const VIP_TOPUP_BONUS = 0.2; // +20% к дневному лимиту пополнения для VIP

function isVIP(){
  return state.totalWagered >= VIP_WAGER_THRESHOLD;
}

function getRemainingTopup(){
  if(state.dailyTopupDate !== todayKey()){
    state.dailyTopupDate = todayKey();
    state.dailyTopupUsed = 0;
  }
  const limit = isVIP() ? Math.round(DAILY_TOPUP_LIMIT * (1 + VIP_TOPUP_BONUS)) : DAILY_TOPUP_LIMIT;
  return Math.max(0, limit - state.dailyTopupUsed);
}

function applyTopup(amount){
  const remaining = getRemainingTopup();
  if(remaining <= 0){
    toast(`Дневной лимит демо-пополнения исчерпан (${formatNum(DAILY_TOPUP_LIMIT)} ₲/сутки)`, 'lose');
    return false;
  }
  const actual = Math.min(amount, remaining);
  state.balance += actual;
  state.dailyTopupUsed += actual;
  saveState();
  if(actual < amount){
    toast(`Начислено только +${formatNum(actual)} ₲ — достигнут дневной лимит`, 'info');
  } else {
    toast(`+${formatNum(actual)} монет добавлено`, 'win');
  }
  return true;
}

function renderBalance(){
  document.querySelectorAll('.js-balance').forEach(el=>{
    el.textContent = formatNum(state.balance);
  });
  document.getElementById('topBalance').textContent = formatNum(state.balance);
}

function formatNum(n){
  n = Math.round(n * 100) / 100;
  return n.toLocaleString('ru-RU', {maximumFractionDigits: 2});
}

function vibrate(ms){
  if(!state.vibrationEnabled) return;
  if(navigator.vibrate) navigator.vibrate(ms);
}

/* ============ ЗВУКОВОЙ ДВИЖОК (Web Audio API) ============ */
let audioCtx = null;
function getAudioCtx(){
  if(!state.soundEnabled) return null;
  if(!audioCtx){
    try{
      const AC = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AC();
    }catch(e){ return null; }
  }
  if(audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}

function playTick(freq, duration, gainLevel){
  const ctx = getAudioCtx();
  if(!ctx) return;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = 'square';
  osc.frequency.value = freq || 700;
  gain.gain.setValueAtTime(gainLevel || 0.06, ctx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + (duration || 0.05));
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start();
  osc.stop(ctx.currentTime + (duration || 0.05));
}

// Звук вращающегося колеса: серия тиков, замедляющихся к концу, имитирует физическое колесо
function playWheelSpinSound(totalDurationMs){
  const ctx = getAudioCtx();
  if(!ctx) return;
  const total = totalDurationMs || 3600;
  let elapsed = 0;
  let interval = 45; // начальный интервал между тиками (быстро)
  const maxInterval = 260; // интервал в конце (медленно)

  function scheduleNextTick(){
    if(elapsed >= total) return;
    playTick(650 + Math.random()*80, 0.035, 0.05);
    const progress = elapsed / total;
    interval = 45 + (maxInterval - 45) * Math.pow(progress, 2); // квадратичное замедление
    elapsed += interval;
    setTimeout(scheduleNextTick, interval);
  }
  scheduleNextTick();
}

function playWinChime(){
  const ctx = getAudioCtx();
  if(!ctx) return;
  [660, 880, 1100].forEach((freq, i)=>{
    setTimeout(()=> playTick(freq, 0.15, 0.05), i*80);
  });
}

function pushHistory(entry){
  state.history.unshift(Object.assign({ts: Date.now()}, entry));
  if(state.history.length > 200) state.history.length = 200;
}

const CASHBACK_RATE = 0.15;

function recordBet(game, stake, payout){
  let delta = payout - stake;
  state.totalWagered += stake;
  state.gamesPlayed += 1;
  if(!state.playedGamesSet.includes(game)) state.playedGamesSet.push(game);

  if(!state.perGameStats[game]){
    state.perGameStats[game] = {played:0, wins:0, wagered:0, won:0, lost:0};
  }
  const gs = state.perGameStats[game];
  gs.played += 1;
  gs.wagered += stake;

  let streakBonusApplied = 0;
  if(delta > 0){
    // Бонус серии побед: +2% за каждую предыдущую победу подряд, максимум +20% на 10+ серии.
    // Считается от стрика ДО этой победы - сама эта победа продлевает стрик уже для следующей.
    const streakBonusRate = Math.min(state.currentWinStreak * 0.02, 0.20);
    if(streakBonusRate > 0){
      streakBonusApplied = Math.round(delta * streakBonusRate * 100) / 100;
      delta += streakBonusApplied;
      payout += streakBonusApplied;
    }
    state.currentWinStreak += 1;
    if(state.currentWinStreak > state.bestWinStreak) state.bestWinStreak = state.currentWinStreak;

    state.totalWon += delta;
    if(delta > state.bestWin) state.bestWin = delta;
    state.winsCount += 1;
    gs.wins += 1;
    gs.won += delta;
    // 15% от суммы выигрыша копится в кэшбек, доступный к начислению отдельно
    const bonuses = getTalentBonuses();
    state.cashback += delta * (CASHBACK_RATE + bonuses.cashbackBonus);
  } else if(delta < 0){
    state.currentWinStreak = 0;
    state.totalLost += Math.abs(delta);
    gs.lost += Math.abs(delta);
  }
  state.balance += delta;
  pushHistory({game, stake, payout, delta, streakBonus: streakBonusApplied});
  awardTalentPointsForWager();
  saveState();

  // Отдельное уведомление о бонусе серии - каждая игра показывает свой результат
  // с исходной суммой ДО вызова recordBet, поэтому здесь явно поясняем добавку,
  // чтобы баланс и то, что видит игрок, не расходились молча.
  if(streakBonusApplied > 0){
    setTimeout(()=>{
      toast(`🔥 Серия x${state.currentWinStreak}! Бонус +${formatNum(streakBonusApplied)} ₲`, 'win');
    }, 350);
  }
}

function toast(msg, kind){
  kind = kind || 'info';
  const holder = document.getElementById('toastHolder') || createToastHolder();
  const t = document.createElement('div');
  t.className = 'toast toast-' + kind;
  t.textContent = msg;
  holder.appendChild(t);
  requestAnimationFrame(()=> t.classList.add('show'));
  setTimeout(()=>{
    t.classList.remove('show');
    setTimeout(()=> t.remove(), 300);
  }, 2600);
}

function createToastHolder(){
  const el = document.createElement('div');
  el.id = 'toastHolder';
  el.style.cssText = 'position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 62px);transform:translateX(-50%);z-index:999;display:flex;flex-direction:column;gap:8px;align-items:center;width:100%;max-width:440px;padding:0 16px;pointer-events:none;';
  document.body.appendChild(el);
  return el;
}

/* Inject toast styles once */
(function injectToastStyles(){
  const s = document.createElement('style');
  s.textContent = `
    .toast{
      background: linear-gradient(145deg, #241a2e, #1a1223);
      border:1px solid rgba(255,255,255,0.14);
      color:#f3ecf7;
      padding:11px 16px;
      border-radius:13px;
      font-size:13.5px;
      font-weight:600;
      box-shadow:0 10px 26px rgba(0,0,0,0.45);
      opacity:0;
      transform: translateY(-14px);
      transition: opacity .28s ease, transform .28s ease;
      max-width:100%;
      text-align:center;
    }
    .toast-win{ border-color: rgba(62,207,142,0.5); color:#a4f2ce; }
    .toast-lose{ border-color: rgba(239,77,107,0.5); color:#ffb2c1; }
    .toast-info{ border-color: rgba(155,107,255,0.5); }
    .toast.show{ opacity:1; transform: translateY(0); }
  `;
