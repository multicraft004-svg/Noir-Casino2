function buildMinesMultipliers(totalCells, bombs){
  // Строим прогрессию множителей по числу открытых безопасных клеток.
  // Первые 3 шага фиксированы по запросу: 1.05x, 1.31x, 1.70x.
  // Дальнейшие шаги считаются от РЕАЛЬНОЙ вероятности дойти до этого шага
  // на конкретном поле, с честным заявленным домашним эджем ~8% (RTP ~92%),
  // как в остальных играх. Это не даёт казино уйти в минус на поздних шагах.
  const safeCells = totalCells - bombs;
  const fixed = [1.05, 1.31, 1.70];
  const houseEdgeRTP = 0.92;

  // Вероятность дойти до шага step, не подорвавшись (без замены, гипергеометрически)
  function probReachStep(step){
    let prob = 1;
    for(let i = 0; i < step; i++){
      const remaining = totalCells - i;
      const safeRemaining = safeCells - i;
      prob *= safeRemaining / remaining;
    }
    return prob;
  }

  const MULT_CAP = 500; // разумный потолок, чтобы не улетать в абсурдные числа на последних клетках
  const mults = [];
  for(let step = 1; step <= safeCells; step++){
    if(step <= fixed.length){
      mults.push(fixed[step-1]);
    } else {
      const fairMult = houseEdgeRTP / probReachStep(step);
      // Не даём множителю быть ниже предыдущего шага (монотонный рост), но ограничиваем потолком
      const prev = mults[mults.length-1];
      const next = Math.max(prev, Math.round(fairMult * 100) / 100);
      mults.push(Math.min(next, MULT_CAP));
    }
  }
  return mults;
}

function startMines(stake, gridSize, bombCount, body){
  state.balance -= stake;
  saveState();

  const totalCells = gridSize * gridSize;
  const bombPositions = new Set();
  while(bombPositions.size < bombCount){
    bombPositions.add(Math.floor(Math.random() * totalCells));
  }

  minesState = {
    stake, gridSize, bombCount, totalCells,
    bombPositions,
    opened: new Set(),
    multipliers: buildMinesMultipliers(totalCells, bombCount),
    ended: false
  };

  renderMinesBoard(body);
}

function renderMinesBoard(body){
  body.innerHTML = '';
  const ms = minesState;

  body.appendChild(el('div', {class:'odds-badge'}, [`🎯 Поле ${ms.gridSize}×${ms.gridSize} · ${ms.bombCount} ${ms.bombCount===1?'бомба':'бомбы'}`]));

  const currentStep = ms.opened.size;
  const currentMult = currentStep === 0 ? 1.00 : ms.multipliers[currentStep - 1];
  const potentialPayout = ms.stake * currentMult;

  const topInfo = el('div', {class:'mines-topinfo'}, [
    el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['Ставка']),
      el('div', {class:'mines-info-value'}, [formatNum(ms.stake) + ' ₲'])
    ]),
    el('div', {class:'mines-info-box highlight'}, [
      el('div', {class:'mines-info-label'}, ['Множитель']),
      el('div', {class:'mines-info-value'}, ['x' + currentMult.toFixed(2)])
    ]),
    el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['Заберёте']),
      el('div', {class:'mines-info-value gold'}, [formatNum(potentialPayout) + ' ₲'])
    ]),
  ]);
  body.appendChild(topInfo);

  const grid = el('div', {class:'mines-grid', style:`grid-template-columns: repeat(${ms.gridSize}, 1fr);`});
  for(let i=0; i<ms.totalCells; i++){
    const isOpened = ms.opened.has(i);
    const isBomb = ms.bombPositions.has(i);
    const cell = el('button', {class:'mines-cell' + (isOpened?' opened':'') + (ms.ended && isBomb ? ' bomb-reveal':'')}, []);
    if(isOpened){
      cell.classList.add('safe');
      cell.textContent = '💎';
    } else if(ms.ended && isBomb){
      cell.textContent = '💣';
    }
    if(!ms.ended && !isOpened){
      cell.addEventListener('click', ()=> handleMinesClick(i, body));
    } else {
      cell.disabled = true;
    }
    grid.appendChild(cell);
  }
  body.appendChild(grid);

  const btnRow = el('div', {class:'mines-btnrow'});
  if(!ms.ended){
    const canCashout = ms.opened.size > 0;
    btnRow.appendChild(el('button', {
      class:'btn btn-violet btn-block',
      disabled: !canCashout,
      onclick: ()=> cashoutMines(body)
    }, [canCashout ? `💰 Забрать ${formatNum(potentialPayout)} ₲` : '💰 Откройте хотя бы 1 клетку']));
    btnRow.appendChild(el('button', {class:'btn btn-ghost btn-block btn-sm', style:'margin-top:8px;', onclick:()=>{
      // Отмена раунда — возвращаем ставку только если ничего не открыто
      if(ms.opened.size === 0){
        state.balance += ms.stake;
        saveState();
      }
      minesState = null;
      body.innerHTML = '';
      body.appendChild(minesSetupView(body));
    }}, [ms.opened.size === 0 ? 'Отменить раунд' : 'Сдаться (без выплаты)']));
  } else {
    btnRow.appendChild(el('div', {class:'crash-result ' + (ms.won ? 'win' : 'lose'), style:'opacity:1;'}, [
      ms.won
        ? `✅ Забрано! Выигрыш +${formatNum(ms.payout - ms.stake)} ₲`
        : `💥 Бомба! Проигрыш ${formatNum(ms.stake)} ₲`
    ]));
    btnRow.appendChild(el('button', {class:'btn btn-primary btn-block', style:'margin-top:10px;', onclick:()=>{
      minesState = null;
      body.innerHTML = '';
      body.appendChild(minesSetupView(body));
    }}, ['🎮 Играть снова']));
  }
  body.appendChild(btnRow);
}

function handleMinesClick(index, body){
  const ms = minesState;
  if(ms.ended) return;

  if(ms.bombPositions.has(index)){
    ms.opened.add(index);
    ms.ended = true;
    ms.won = false;
    vibrate([40,30,60]);
    recordBet('mines', ms.stake, 0);
    renderMinesBoard(body);
    return;
  }

  ms.opened.add(index);
  vibrate(15);

  if(ms.opened.size === ms.totalCells - ms.bombCount){
    // Открыты все безопасные клетки — авто-выигрыш по максимальному множителю
    ms.ended = true;
    ms.won = true;
    const mult = ms.multipliers[ms.opened.size - 1];
    ms.payout = ms.stake * mult;
    recordBet('mines', ms.stake, ms.payout);
  }

  renderMinesBoard(body);
}

function cashoutMines(body){
  const ms = minesState;
  if(ms.ended || ms.opened.size === 0) return;
  const mult = ms.multipliers[ms.opened.size - 1];
  ms.payout = ms.stake * mult;
  ms.ended = true;
  ms.won = true;
  vibrate(25);
  recordBet('mines', ms.stake, ms.payout);
  renderMinesBoard(body);
}

