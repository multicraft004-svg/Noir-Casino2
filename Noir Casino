  body.appendChild(participantsList);

  const stakePanel = el('div', {class:'stake-panel'});
  stakePanel.appendChild(el('div', {class:'stake-label'}, ['Твоя ставка']));
  const stakeCtl = stakeControl(200, ()=> updatePvpPreview());
  stakePanel.appendChild(stakeCtl);
  body.appendChild(stakePanel);

  const joinBtn = el('button', {class:'btn btn-primary btn-block'}, ['🎡 Присоединиться к раунду']);
  body.appendChild(joinBtn);

  const resultEl = el('div', {class:'crash-result'});
  body.appendChild(resultEl);

  let bots = generatePvpBots(5 + Math.floor(Math.random()*4));
  let refs = {wheelSvgWrap, bankInfo, participantsList, stakeCtl, joinBtn, resultEl};

  function updatePvpPreview(){
    renderPvpWheelAndList(bots, stakeCtl.getValue(), refs);
  }
  updatePvpPreview();

  joinBtn.addEventListener('click', ()=>{
    if(pvpState.spinning) return;
    const stake = stakeCtl.getValue();
    if(stake <= 0){ toast('Введите ставку', 'lose'); return; }
    if(stake > state.balance){ toast('Недостаточно средств', 'lose'); return; }
    spinPvpRoulette(stake, bots, refs, ()=>{
      bots = generatePvpBots(5 + Math.floor(Math.random()*4));
      refs = {wheelSvgWrap, bankInfo, participantsList, stakeCtl, joinBtn, resultEl};
      updatePvpPreview();
    });
  });

  c.appendChild(body);
  injectPvpStylesOnce();
  return c;
}

function renderPvpWheelAndList(bots, myStake, refs){
  const totalBank = bots.reduce((s,b)=>s+b.stake, 0) + myStake;
  const myColor = 'hsl(45, 90%, 62%)'; // золотой — цвет игрока, отличается от ботов

  // Строим колесо через conic-gradient — просто и честно отражает пропорции
  let cursor = 0;
  const stops = [];
  const allEntries = [...bots.map(b=>({...b})), {name: state.nickname || 'Вы', stake: myStake, color: myColor, isMe:true}];
  allEntries.forEach(entry=>{
    const share = entry.stake / totalBank;
    const start = cursor * 360;
    cursor += share;
    const end = cursor * 360;
    stops.push(`${entry.color} ${start}deg ${end}deg`);
  });

  refs.wheelSvgWrap.innerHTML = '';
  const wheel = el('div', {class:'pvp-wheel', style:`background: conic-gradient(${stops.join(', ')});`});
  refs.wheelSvgWrap.appendChild(wheel);
  refs.wheelSvgWrap.appendChild(el('div', {class:'pvp-wheel-center'}, ['₲']));

  refs.bankInfo.innerHTML = '';
  refs.bankInfo.appendChild(el('div', {class:'mines-info-box'}, [
    el('div', {class:'mines-info-label'}, ['Банк раунда']),
    el('div', {class:'mines-info-value gold'}, [formatNum(totalBank) + ' ₲'])
  ]));
  refs.bankInfo.appendChild(el('div', {class:'mines-info-box highlight'}, [
    el('div', {class:'mines-info-label'}, ['Твой шанс']),
    el('div', {class:'mines-info-value'}, [((myStake/totalBank)*100).toFixed(1) + '%'])
  ]));
  refs.bankInfo.appendChild(el('div', {class:'mines-info-box'}, [
    el('div', {class:'mines-info-label'}, ['При победе']),
    el('div', {class:'mines-info-value gold'}, [formatNum(totalBank) + ' ₲'])
  ]));

  refs.participantsList.innerHTML = '';
  const sorted = [...allEntries].sort((a,b)=> b.stake - a.stake);
  sorted.forEach(entry=>{
    const row = el('div', {class:'pvp-participant-row' + (entry.isMe?' me':'')});
    row.appendChild(el('div', {class:'pvp-color-dot', style:`background:${entry.color}; box-shadow: 0 0 8px ${entry.color};`}));
    row.appendChild(el('div', {class:'pvp-participant-name'}, [entry.isMe ? (state.nickname||'Вы') + ' (вы)' : entry.name]));
    row.appendChild(el('div', {class:'pvp-participant-stake'}, [formatNum(entry.stake) + ' ₲']));
    refs.participantsList.appendChild(row);
  });
}

function spinPvpRoulette(myStake, bots, refs, onDone){
  pvpState.spinning = true;
  state.balance -= myStake;
  saveState();
  refs.joinBtn.disabled = true;
  refs.joinBtn.textContent = '🎡 Крутится...';
  refs.resultEl.className = 'crash-result';
  refs.resultEl.textContent = '';
  playWheelSpinSound(3600);

  const totalBank = bots.reduce((s,b)=>s+b.stake, 0) + myStake;
  const myColor = 'hsl(45, 90%, 62%)';
  const allEntries = [...bots.map(b=>({...b})), {name: state.nickname||'Вы', stake: myStake, color: myColor, isMe:true}];

  // Честный выбор победителя пропорционально ставке
  let r = Math.random() * totalBank;
  let winner = allEntries[allEntries.length-1];
  let winnerIndex = allEntries.length - 1;
  for(let i=0; i<allEntries.length; i++){
    const entry = allEntries[i];
    if(r < entry.stake){ winner = entry; winnerIndex = i; break; }
    r -= entry.stake;
  }

  // Вычисляем реальный угол сегмента победителя на колесе (conic-gradient строится в том же порядке allEntries)
  let angleCursor = 0;
  for(let i=0; i<winnerIndex; i++){
    angleCursor += (allEntries[i].stake / totalBank) * 360;
  }
  const winnerSegmentSize = (winner.stake / totalBank) * 360;
  const winnerAngleCenter = angleCursor + winnerSegmentSize / 2;

  const wheelEl = refs.wheelSvgWrap.querySelector('.pvp-wheel');
  const spins = 5 + Math.floor(Math.random()*2);
  // Указатель фиксирован сверху (0deg). Чтобы сегмент победителя оказался под указателем,
  // поворачиваем колесо так, чтобы (spins*360 - winnerAngleCenter) совпало с 0deg сверху.
  const finalRotation = spins*360 + (360 - winnerAngleCenter);
  wheelEl.style.transition = 'transform 3.6s cubic-bezier(0.15,0.85,0.2,1)';
  wheelEl.style.transform = `rotate(${finalRotation}deg)`;

  setTimeout(()=>{
    const iWon = winner.isMe === true;
    // payout передаём как totalBank + myStake, потому что recordBet() вычтет myStake
    // ещё раз при расчёте чистой прибыли (delta = payout - stake). Без этой поправки
    // ставка списывалась дважды: один раз при старте раунда (строка выше),
    // второй раз неявно внутри recordBet — из-за чего реальная выплата была
    // на сумму ставки меньше, чем показанный банк.
    const payout = iWon ? (totalBank + myStake) : 0;
    vibrate(iWon ? [20,20,20] : [40,30,60]);
    if(iWon) playWinChime();
    recordBet('pvp', myStake, payout);

    refs.resultEl.className = 'crash-result ' + (iWon?'win':'lose');
    refs.resultEl.textContent = iWon
      ? `🏆 Победа! Забран весь банк: +${formatNum(totalBank)} ₲`
      : `😔 Победил ${winner.name}. Проигрыш ${formatNum(myStake)} ₲`;

    pvpState.spinning = false;
    refs.joinBtn.disabled = false;
    refs.joinBtn.textContent = '🎡 Новый раунд';
    onDone();
  }, 3700);
}

