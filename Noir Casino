          el('div', {class:'talent-linear-info'}, [
            el('div', {class:'talent-linear-level'}, ['Уровень ' + nextTalent.level + ' из ' + branchLevels.length]),
            el('div', {class:'talent-linear-cost'}, [nextTalent.cost + ' ⭐ очков'])
          ]),
          el('button', {
            class:'btn btn-primary btn-sm',
            disabled: !canUnlock,
            onclick: ()=>{
              if(unlockTalent(nextTalent.id)){
                vibrate(20);
                toast('Открыт: ' + nextTalent.title, 'win');
                renderScreen();
              }
            }
          }, ['Улучшить'])
        ]));
      }
      body.appendChild(wrap);
    } else {
      const grid = el('div', {class:'talent-grid' + (isOpen?'':' locked')});
      branchLevels.forEach(talent=>{
        const unlocked = isTalentUnlocked(talent.id);
        const canUnlock = canUnlockTalent(talent);
        let cellClass = 'talent-node';
        if(unlocked) cellClass += ' unlocked';
        else if(canUnlock) cellClass += ' available';
        else cellClass += ' locked';

        const node = el('button', {class:cellClass}, [
          el('div', {class:'talent-node-level'}, [String(talent.level)]),
          el('div', {class:'talent-node-cost'}, [unlocked ? '✓' : talent.cost + '⭐'])
        ]);
        if(canUnlock){
          node.addEventListener('click', ()=>{
            if(unlockTalent(talent.id)){
              vibrate(20);
              toast('Открыт: ' + talent.title, 'win');
              renderScreen();
            }
          });
        } else {
          node.disabled = true;
        }
        grid.appendChild(node);
      });
      body.appendChild(grid);
    }
  });

  c.appendChild(body);
  injectTalentTreeStylesOnce();
  return c;
}

