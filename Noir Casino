/* =========================================================
   7) PVP-РУЛЕТКА (демо)
   Круглое колесо, сегменты пропорциональны размеру ставки каждого участника.
   Участники — демо-боты с разными именами и RGB-цветами (не реальные игроки,
   в браузерном HTML-файле без сервера нет способа синхронизировать реальных людей).
   Победитель забирает весь банк раунда. Выигрыш идёт в личный виртуальный баланс.
   Честная математика: шанс победы = доля твоей ставки от общего банка.
   ========================================================= */
let pvpState = { spinning:false };

const PVP_BOT_NAMES = [
  'ShadowBet','GoldRush99','NeonKing','ViperStake','LuckyFox','MaxWinner','DarkHorse','StormRider',
  'IceCold_88','PhoenixBet','ThunderX','MysticWin','RapidFire','BlazeStake','FrostBite_','SilverBullet'
];

function randomVibrantColor(){
  const h = Math.floor(Math.random()*360);
  return `hsl(${h}, 75%, 58%)`;
}

// Ставка бота зависит от его "ранга" (имитация того, что топ-игроки ставят больше).
// Ранги 1-5: ранг 1 - рядовой игрок (~1k-4k), ранг 5 - топ-игрок (~18k-30k).
// Распределение смещено в сторону низких рангов - топ-игроки встречаются реже.
const PVP_RANK_TIERS = [
  {min:50000, max:4000, weight:40},
  {min:3000, max:8000, weight:28},
  {min:10000, max:14000, weight:18},
  {min:10000, max:100000, weight:10},
  {min:18000, max:300000, weight:4},
];

function pickWeightedRank(){
  const totalWeight = PVP_RANK_TIERS.reduce((s,t)=>s+t.weight, 0);
  let r = Math.random() * totalWeight;
  for(const tier of PVP_RANK_TIERS){
    if(r < tier.weight) return tier;
    r -= tier.weight;
  }
  return PVP_RANK_TIERS[0];
}

function generatePvpBots(count){
  const shuffled = [...PVP_BOT_NAMES].sort(()=>Math.random()-0.5);
  const bots = [];
  for(let i=0; i<count; i++){
    const tier = pickWeightedRank();
    bots.push({
      name: shuffled[i % shuffled.length] + (i >= shuffled.length ? '_'+i : ''),
      stake: Math.round(tier.min + Math.random()*(tier.max - tier.min)),
      color: randomVibrantColor()
    });
  }
  return bots;
}

