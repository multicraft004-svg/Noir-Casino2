/* =========================================================
   ДЕРЕВО ТАЛАНТОВ
   ~100 улучшений, разбитых на 5 веток по 20 штук.
   Каждый талант даёт небольшой процентный бонус (шанс/кэшбек/дневной лимит).
   Открывать можно только по порядку внутри ветки (нужен предыдущий уровень).
   Первая ветка ("Удача") открыта изначально, остальные разблокируются
   после того как в "Удаче" открыто хотя бы 5 уровней.
   Очки начисляются за игровой оборот: 1 очко за каждые 500 ₲ ставок.
   ========================================================= */

const TALENT_BRANCHES = [
  {id:'luck', title:'Удача', icon:'🍀', desc:'+0.15% к шансу на выигрыш за уровень', color:'emerald'},
  {id:'cashback', title:'Кэшбек', icon:'💎', desc:'+0.3% к ставке кэшбека за уровень', color:'violet'},
  {id:'fortune', title:'Фортуna', icon:'✨', desc:'+0.1% к шансу + мелкий бонус монет', color:'gold'},
  {id:'discipline', title:'Дисциплина', icon:'🛡️', desc:'+3% к дневному лимиту пополнения за уровень', color:'crimson'},
  {id:'mastery', title:'Мастерство', icon:'👑', desc:'Комбинированные бонусы для опытных игроков', color:'gold'},
  {id:'greatness', title:'Величие', icon:'🌟', desc:'+0.02% к удаче за уровень · долгий грайнд на 200 уровней', color:'gold', levels:200, costPerLevel:2},
];

function buildTalentTree(){
  const tree = [];
  TALENT_BRANCHES.forEach((branch, bIdx)=>{
    const levelCount = branch.levels || 20;
    const costPerLevel = branch.costPerLevel; // если задано - фиксированная дешёвая стоимость (для длинных веток)
    for(let lvl=1; lvl<=levelCount; lvl++){
      tree.push({
        id: branch.id + '_' + lvl,
        branch: branch.id,
        level: lvl,
        cost: costPerLevel || lvl, // стоимость в очках талантов растёт линейно с уровнем внутри ветки
        title: branch.title + ' ' + lvl,
      });
    }
  });
  return tree;
}
const TALENT_TREE = buildTalentTree();

function talentsUnlockedCount(){
  return state.unlockedTalents ? state.unlockedTalents.length : 0;
}

function isTalentUnlocked(id){
  return state.unlockedTalents && state.unlockedTalents.includes(id);
}

function isBranchOpen(branchId){
  if(branchId === 'luck') return true;
  // остальные ветки открываются после 5 уровней в "Удаче"
  const luckLevels = (state.unlockedTalents||[]).filter(id=>id.startsWith('luck_')).length;
  return luckLevels >= 5;
}

function canUnlockTalent(talent){
  if(isTalentUnlocked(talent.id)) return false;
  if(!isBranchOpen(talent.branch)) return false;
  if(talent.level > 1){
    const prevId = talent.branch + '_' + (talent.level - 1);
    if(!isTalentUnlocked(prevId)) return false;
  }
  return state.talentPoints >= talent.cost;
}

function unlockTalent(talentId){
  const talent = TALENT_TREE.find(t=>t.id===talentId);
  if(!talent || !canUnlockTalent(talent)) return false;
  state.talentPoints -= talent.cost;
  state.unlockedTalents.push(talentId);
  saveState();
  return true;
}

// Начисление очков талантов за игровой оборот — вызывается из recordBet
function awardTalentPointsForWager(){
  const pointsPerWager = 500; // 1 очко за каждые 500 ₲ суммарных ставок
  const shouldHave = Math.floor(state.totalWagered / pointsPerWager);
  const already = Math.floor((state.talentPointsAwardedAtWager||0) / pointsPerWager);
  if(shouldHave > already){
    const gained = shouldHave - already;
    state.talentPoints += gained;
    state.talentPointsAwardedAtWager = state.totalWagered;
  }
}

// Суммарные бонусы от открытых талантов — используются в игровой логике
/* =========================================================
   СИСТЕМА УРОВНЕЙ / ЛИГ ИГРОКА
   21 уровень, сгруппированы в 4 лиги. Уровень растёт от общего оборота ставок.
   Каждый уровень даёт небольшой бонус к кэшбеку и шансу — суммарно на 21 уровне
   это +5.25% к кэшбеку и +0.84% к шансу, заметно, но не ломает баланс игры.
   ========================================================= */
const LEVEL_WAGER_STEP = 5000; // сколько нужно поставить для перехода на следующий уровень
const MAX_PLAYER_LEVEL = 21;

const LEAGUES = [
  {name:'Бронза', icon:'🥉', minLevel:1, maxLevel:5, color:'#c17a3f'},
  {name:'Серебро', icon:'🥈', minLevel:6, maxLevel:10, color:'#b8bfc7'},
  {name:'Золото', icon:'🥇', minLevel:11, maxLevel:15, color:'#e8b84b'},
  {name:'Алмаз', icon:'💎', minLevel:16, maxLevel:21, color:'#7dd8ff'},
];

function getPlayerLevel(){
  return Math.min(MAX_PLAYER_LEVEL, Math.floor(state.totalWagered / LEVEL_WAGER_STEP) + 1);
}

function getLeagueForLevel(level){
  return LEAGUES.find(l => level >= l.minLevel && level <= l.maxLevel) || LEAGUES[0];
}

function getLevelProgress(){
  const level = getPlayerLevel();
  if(level >= MAX_PLAYER_LEVEL) return {level, league: getLeagueForLevel(level), pct: 100, wagered: state.totalWagered, nextAt: null};
  const currentFloor = (level - 1) * LEVEL_WAGER_STEP;
  const nextAt = level * LEVEL_WAGER_STEP;
  const pct = ((state.totalWagered - currentFloor) / (nextAt - currentFloor)) * 100;
  return {level, league: getLeagueForLevel(level), pct: Math.max(0, Math.min(100, pct)), wagered: state.totalWagered, nextAt};
}

function getLevelBonuses(){
  const level = getPlayerLevel();
  return {
    cashbackBonus: level * 0.0025, // +0.25% за уровень, макс +5.25%
    luckBonus: level * 0.0004, // +0.04% за уровень, макс +0.84%
  };
}

function getTalentBonuses(){
  const unlocked = state.unlockedTalents || [];
  let luckLevels = 0, cashbackLevels = 0, fortuneLevels = 0, disciplineLevels = 0, greatnessLevels = 0;
  unlocked.forEach(id=>{
    if(id.startsWith('luck_')) luckLevels++;
    else if(id.startsWith('cashback_')) cashbackLevels++;
    else if(id.startsWith('fortune_')) fortuneLevels++;
    else if(id.startsWith('discipline_')) disciplineLevels++;
    else if(id.startsWith('greatness_')) greatnessLevels++;
  });
  const levelBonuses = getLevelBonuses();
  return {
    luckBonus: luckLevels * 0.0015 + fortuneLevels * 0.001 + greatnessLevels * 0.0002 + levelBonuses.luckBonus,
    cashbackBonus: cashbackLevels * 0.003 + levelBonuses.cashbackBonus, // добавка к ставке кэшбека, доля
    topupBonus: disciplineLevels * 0.03, // добавка к дневному лимиту пополнения, доля
  };
}

