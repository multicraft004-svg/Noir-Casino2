function getMissionProgress(mission){
  switch(mission.type){
    case 'gamesPlayed': return state.gamesPlayed;
    case 'totalWagered': return state.totalWagered;
    case 'winsCount': return state.winsCount;
    case 'uniqueGames': return (state.playedGamesSet||[]).length;
    case 'bestWin': return state.bestWin;
    default: return 0;
  }
}

function isMissionComplete(mission){
  return getMissionProgress(mission) >= mission.target;
}

function isMissionClaimed(mission){
  return (state.claimedMissions||[]).includes(mission.id);
}

function claimMission(missionId){
  const mission = MISSIONS_LIST.find(m=>m.id===missionId);
  if(!mission) return;
  if(isMissionClaimed(mission) || !isMissionComplete(mission)) return;
  state.balance += mission.reward;
  state.claimedMissions.push(mission.id);
  saveState();
  toast('+' + formatNum(mission.reward) + ' ₲ за задание "' + mission.title + '"', 'win');
