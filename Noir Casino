/* =========================================================
   4.5) СЕЙФ (Safe)
   Как Башня, но на каждом уровне нужно найти 2 ключа из 4 ячеек.
   Множители заданы: 3.18x, 6.49x, 9.30x, 12.21x на уровнях 1-4.
   ========================================================= */
let safeState = null;
const SAFE_LEVELS = 4;
const SAFE_COLS = 4;
const SAFE_KEYS_NEEDED = 2;
const SAFE_MULTIPLIERS = [3.18, 6.49, 9.30, 12.21];

function renderSafeGame(){
  injectGameSharedStylesOnce();
  const c = el('div', {});
  c.appendChild(gameHeader('Сейф', 'Найди 2 ключа из 4 на каждом уровне'));

  const body = el('div', {class:'game-body'});
  body.appendChild(safeSetupView(body));

  c.appendChild(body);
  injectSafeStylesOnce();
  return c;
}

function safeSetupView(body){
  const wrap = el('div', {id:'safeSetupWrap'});
  wrap.appendChild(el('div', {class:'odds-badge'}, [`🎯 ${SAFE_LEVELS} уровня · найди ${SAFE_KEYS_NEEDED} ключа из ${SAFE_COLS}`]));

  const multPreview = el('div', {class:'safe-mult-preview'});
  SAFE_MULTIPLIERS.forEach((m,i)=>{
    multPreview.appendChild(el('div', {class:'safe-mult-chip'}, [`Ур.${i+1} · x${m.toFixed(2)}`]));
  });
  wrap.appendChild(multPreview);

  const stakePanel = el('div', {class:'stake-panel'});
  stakePanel.appendChild(el('div', {class:'stake-label'}, ['Ставка']));
  const stakeCtl = stakeControl(100, ()=>{});
  stakePanel.appendChild(stakeCtl);
  wrap.appendChild(stakePanel);

  wrap.appendChild(el('button', {class:'btn btn-primary btn-block', onclick:()=>{
    const stake = stakeCtl.getValue();
    if(stake <= 0){ toast('Введите ставку', 'lose'); return; }
    if(stake > state.balance){ toast('Недостаточно средств', 'lose'); return; }
    startSafe(stake, body);
  }}, ['🔐 Открыть сейф']));

  return wrap;
}

function startSafe(stake, body){
  state.balance -= stake;
  saveState();

  const levels = [];
  for(let i=0; i<SAFE_LEVELS; i++){
    // 2 случайные позиции ключей из 4 ячеек на каждом уровне
    const keyPositions = new Set();
    while(keyPositions.size < SAFE_KEYS_NEEDED){
      keyPositions.add(Math.floor(Math.random()*SAFE_COLS));
    }
    levels.push(keyPositions);
  }

  safeState = {
    stake, levels, currentLevel: 0,
    ended: false, picks: [], // picks[level] = массив выбранных индексов на этом уровне
    picksThisLevel: []
  };

  renderSafeBoard(body);
}

function renderSafeBoard(body){
  body.innerHTML = '';
  const ss = safeState;

  body.appendChild(el('div', {class:'odds-badge'}, [`🎯 Уровень ${ss.currentLevel+1} из ${SAFE_LEVELS} · найди ${SAFE_KEYS_NEEDED} ключа`]));

  const currentMult = ss.currentLevel === 0 ? 1.00 : SAFE_MULTIPLIERS[ss.currentLevel - 1];
  const potentialPayout = ss.stake * currentMult;

  const topInfo = el('div', {class:'mines-topinfo'}, [
    el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['Ставка']),
      el('div', {class:'mines-info-value'}, [formatNum(ss.stake) + ' ₲'])
    ]),
    el('div', {class:'mines-info-box highlight'}, [
      el('div', {class:'mines-info-label'}, ['Множитель']),
      el('div', {class:'mines-info-value'}, ['x' + currentMult.toFixed(2)])
    ]),
    el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['Заберёте']),
      el('div', {class:'mines-info-value gold'}, [formatNum(potentialPayout) + ' ₲'])
    ]),
  ]);
  body.appendChild(topInfo);

  // Визуальная лестница уровней сбоку — весь путь целиком виден сразу
  body.appendChild(renderSafeLadder(ss));

  if(!ss.ended){
    const picksThisLevel = ss.picksThisLevel;
    const cellsRow = el('div', {class:'safe-cells'});
    for(let col=0; col<SAFE_COLS; col++){
      const alreadyPicked = picksThisLevel.includes(col);
      let cellClass = 'safe-cell';
      let content = '';
      if(alreadyPicked){
        const wasKey = ss.levels[ss.currentLevel].has(col);
        cellClass += wasKey ? ' key-found' : ' empty-found';
        content = wasKey ? '🔑' : '✗';
      }
      const cellBtn = el('button', {class:cellClass}, [content]);
      if(!alreadyPicked){
        cellBtn.addEventListener('click', ()=> handleSafeClick(col, body));
      } else {
        cellBtn.disabled = true;
      }
      cellsRow.appendChild(cellBtn);
    }
    body.appendChild(cellsRow);
  }

  const btnRow = el('div', {class:'mines-btnrow'});
  if(!ss.ended){
    const canCashout = ss.currentLevel > 0;
    btnRow.appendChild(el('button', {
      class:'btn btn-violet btn-block',
      disabled: !canCashout,
      onclick: ()=> cashoutSafe(body)
    }, [canCashout ? `💰 Забрать ${formatNum(potentialPayout)} ₲` : '💰 Пройдите хотя бы 1 уровень']));
  } else {
    btnRow.appendChild(el('div', {class:'crash-result ' + (ss.won ? 'win' : 'lose'), style:'opacity:1;'}, [
      ss.won
        ? `✅ Забрано! Выигрыш +${formatNum(ss.payout - ss.stake)} ₲`
        : `💥 Не нашёл оба ключа! Проигрыш ${formatNum(ss.stake)} ₲`
    ]));
    btnRow.appendChild(el('button', {class:'btn btn-primary btn-block', style:'margin-top:10px;', onclick:()=>{
      safeState = null;
      body.innerHTML = '';
      body.appendChild(safeSetupView(body));
    }}, ['🎮 Играть снова']));
  }
  body.appendChild(btnRow);
}

function renderSafeLadder(ss){
  const ladder = el('div', {class:'safe-ladder'});
  for(let lvl = SAFE_LEVELS - 1; lvl >= 0; lvl--){
    const isPast = lvl < ss.currentLevel || (ss.ended && lvl === ss.currentLevel);
    const isCurrent = lvl === ss.currentLevel && !ss.ended;
    const isFuture = lvl > ss.currentLevel;
    let stateClass = 'future';
    if(isCurrent) stateClass = 'current';
    else if(lvl < ss.currentLevel) stateClass = 'passed';
    else if(ss.ended && lvl === ss.currentLevel) stateClass = ss.won ? 'passed' : 'failed';

    ladder.appendChild(el('div', {class:`safe-ladder-step ${stateClass}`}, [
      el('div', {class:'safe-ladder-dot'}, [
        stateClass==='passed' ? '✓' : stateClass==='failed' ? '✗' : String(lvl+1)
      ]),
      el('div', {class:'safe-ladder-label'}, [`Ур.${lvl+1}`]),
      el('div', {class:'safe-ladder-mult'}, ['x'+SAFE_MULTIPLIERS[lvl].toFixed(2)])
    ]));
  }
  return ladder;
}

function handleSafeClick(col, body){
  const ss = safeState;
  if(ss.ended) return;

  ss.picksThisLevel.push(col);
  const isKey = ss.levels[ss.currentLevel].has(col);

  if(!isKey){
    ss.ended = true;
    ss.won = false;
    vibrate([40,30,60]);
    recordBet('safe', ss.stake, 0);
    renderSafeBoard(body);
    return;
  }

  vibrate(15);

  const keysFoundThisLevel = ss.picksThisLevel.filter(c => ss.levels[ss.currentLevel].has(c)).length;
  if(keysFoundThisLevel === SAFE_KEYS_NEEDED){
    // Уровень пройден полностью — переходим дальше или завершаем победой
    ss.currentLevel++;
    ss.picksThisLevel = [];

    if(ss.currentLevel === SAFE_LEVELS){
      ss.ended = true;
      ss.won = true;
      ss.payout = ss.stake * SAFE_MULTIPLIERS[SAFE_LEVELS - 1];
      recordBet('safe', ss.stake, ss.payout);
    }
  }

  renderSafeBoard(body);
}

function cashoutSafe(body){
  const ss = safeState;
  if(ss.ended || ss.currentLevel === 0) return;
  const mult = SAFE_MULTIPLIERS[ss.currentLevel - 1];
  ss.payout = ss.stake * mult;
  ss.ended = true;
  ss.won = true;
  vibrate(25);
  recordBet('safe', ss.stake, ss.payout);
  renderSafeBoard(body);
}

