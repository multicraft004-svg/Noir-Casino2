/* =========================================================
   5) КОСТИ (Dice)
   Ставка на "Больше" или "Меньше" числа 1-100, выбираешь порог.
   Чем экстремальнее порог — тем выше множитель.
   RTP ~92% как в остальных играх.
   ========================================================= */
let diceState = { rolling:false, target: 50, mode: 'over' };

function diceMultiplier(target, mode){
  // Шанс выигрыша: mode 'over' -> (100-target)/100, mode 'under' -> target/100
  const winChance = mode === 'over' ? (100 - target) / 100 : target / 100;
  const houseEdgeRTP = 0.92;
  return houseEdgeRTP / Math.max(winChance, 0.01);
}

function renderDiceGame(){
  injectGameSharedStylesOnce();
  const c = el('div', {});
  c.appendChild(gameHeader('Кости', 'Угадай, больше или меньше выпадет'));

  const body = el('div', {class:'game-body'});
  body.appendChild(el('div', {class:'odds-badge'}, ['🎯 Честный RTP ~92% · множитель зависит от порога']));

  const display = el('div', {class:'dice-display'});
  const resultNum = el('div', {class:'dice-result-num'}, ['—']);
  display.appendChild(resultNum);
  body.appendChild(display);

  // Slider zone
  const sliderZone = el('div', {class:'dice-slider-zone'});
  const track = el('div', {class:'dice-track'});
  const zoneWin = el('div', {class:'dice-zone-win'});
  const zoneLose = el('div', {class:'dice-zone-lose'});
  const handle = el('div', {class:'dice-handle'});
  track.appendChild(zoneLose);
  track.appendChild(zoneWin);
  track.appendChild(handle);
  sliderZone.appendChild(track);
  body.appendChild(sliderZone);

  const infoRow = el('div', {class:'dice-info-row'});
  const chanceBox = el('div', {class:'mines-info-box'}, [
    el('div', {class:'mines-info-label'}, ['Шанс']),
    el('div', {class:'mines-info-value', id:'diceChance'}, ['50.00%'])
  ]);
  const multBox = el('div', {class:'mines-info-box highlight'}, [
    el('div', {class:'mines-info-label'}, ['Множитель']),
    el('div', {class:'mines-info-value', id:'diceMultDisplay'}, ['x1.84'])
  ]);
  const targetBox = el('div', {class:'mines-info-box'}, [
    el('div', {class:'mines-info-label'}, ['Порог']),
    el('div', {class:'mines-info-value', id:'diceTargetDisplay'}, ['50'])
  ]);
  infoRow.appendChild(chanceBox);
  infoRow.appendChild(multBox);
  infoRow.appendChild(targetBox);
  body.appendChild(infoRow);

  const modeRow = el('div', {class:'dice-mode-row'});
  const overBtn = el('button', {class:'dice-mode-btn selected'}, ['📈 Больше']);
  const underBtn = el('button', {class:'dice-mode-btn'}, ['📉 Меньше']);
  modeRow.appendChild(underBtn);
  modeRow.appendChild(overBtn);
  body.appendChild(modeRow);

  function updateSliderUI(){
    const pct = diceState.target;
    handle.style.left = pct + '%';
    if(diceState.mode === 'over'){
      zoneWin.style.left = pct + '%';
      zoneWin.style.width = (100 - pct) + '%';
      zoneLose.style.left = '0%';
      zoneLose.style.width = pct + '%';
    } else {
      zoneWin.style.left = '0%';
      zoneWin.style.width = pct + '%';
      zoneLose.style.left = pct + '%';
      zoneLose.style.width = (100-pct) + '%';
    }
    const mult = diceMultiplier(diceState.target, diceState.mode);
    const winChance = diceState.mode === 'over' ? (100 - diceState.target) : diceState.target;
    chanceBox.querySelector('.mines-info-value').textContent = winChance.toFixed(2) + '%';
    multBox.querySelector('.mines-info-value').textContent = 'x' + mult.toFixed(2);
    targetBox.querySelector('.mines-info-value').textContent = diceState.target;
  }

  function setMode(mode){
    diceState.mode = mode;
    overBtn.classList.toggle('selected', mode==='over');
    underBtn.classList.toggle('selected', mode==='under');
    updateSliderUI();
  }
  overBtn.addEventListener('click', ()=> setMode('over'));
  underBtn.addEventListener('click', ()=> setMode('under'));

  let dragging = false;
  function setTargetFromClientX(clientX){
    const rect = track.getBoundingClientRect();
    let pct = ((clientX - rect.left) / rect.width) * 100;
    pct = Math.max(2, Math.min(98, Math.round(pct)));
    diceState.target = pct;
    updateSliderUI();
  }
  handle.addEventListener('pointerdown', (e)=>{ dragging = true; handle.setPointerCapture(e.pointerId); });
  handle.addEventListener('pointermove', (e)=>{ if(dragging) setTargetFromClientX(e.clientX); });
  handle.addEventListener('pointerup', ()=>{ dragging = false; });
  track.addEventListener('pointerdown', (e)=>{ setTargetFromClientX(e.clientX); });

  updateSliderUI();

  const stakePanel = el('div', {class:'stake-panel'});
  stakePanel.appendChild(el('div', {class:'stake-label'}, ['Ставка']));
  const stakeCtl = stakeControl(100, ()=>{});
  stakePanel.appendChild(stakeCtl);
  body.appendChild(stakePanel);

  const rollBtn = el('button', {class:'btn btn-primary btn-block'}, ['🎲 Бросить кости']);
  body.appendChild(rollBtn);

  const resultEl = el('div', {class:'crash-result'});
  body.appendChild(resultEl);

  rollBtn.addEventListener('click', ()=>{
    if(diceState.rolling) return;
    const stake = stakeCtl.getValue();
    if(stake <= 0){ toast('Введите ставку', 'lose'); return; }
    if(stake > state.balance){ toast('Недостаточно средств', 'lose'); return; }

    diceState.rolling = true;
    rollBtn.disabled = true;
    state.balance -= stake;
    saveState();

    resultNum.classList.add('rolling');
    let ticks = 0;
    const rollInterval = setInterval(()=>{
      resultNum.textContent = (Math.random()*100).toFixed(2);
      ticks++;
    }, 45);

    setTimeout(()=>{
      clearInterval(rollInterval);
      resultNum.classList.remove('rolling');

      const roll = Math.random() * 100;
      const won = diceState.mode === 'over' ? roll > diceState.target : roll < diceState.target;
      const mult = diceMultiplier(diceState.target, diceState.mode);
      const payout = won ? stake * mult : 0;

      resultNum.textContent = roll.toFixed(2);
      resultNum.className = 'dice-result-num ' + (won ? 'win' : 'lose');

      vibrate(won ? 25 : [40,30,60]);
      recordBet('dice', stake, payout);

      resultEl.className = 'crash-result ' + (won?'win':'lose');
      resultEl.textContent = won
        ? `✅ Выпало ${roll.toFixed(2)}! Выигрыш +${formatNum(payout - stake)} ₲`
        : `❌ Выпало ${roll.toFixed(2)}. Проигрыш ${formatNum(stake)} ₲`;

      diceState.rolling = false;
      rollBtn.disabled = false;
    }, 900);
  });

  c.appendChild(body);
  injectDiceStylesOnce();
  return c;
}

