  const now = Date.now();
  const elapsed = now - (state.lastLeaderTickTs || now);
  const tickInterval = 120000; // 2 минуты
  const ticksElapsed = Math.floor(elapsed / tickInterval);
  if(ticksElapsed < 1) return;

  for(let t=0; t<Math.min(ticksElapsed, 5); t++){ // не более 5 тиков разом, чтобы не улететь при долгом отсутствии
    state.fakeLeaders.forEach(p=>{
      if(Math.random() < 0.5){
