    botSide.appendChild(el('div', {class:'duel-name'}, [opponent.name]));
    botSide.appendChild(el('div', {class:'duel-stake'}, [formatNum(opponent.stake) + ' ₲']));
    botSide.appendChild(el('div', {class:'duel-chance'}, [((opponent.stake/total)*100).toFixed(1) + '%']));

    barMe.style.width = ((myStake/total)*100) + '%';
    barBot.style.width = ((opponent.stake/total)*100) + '%';
  }
  updateDuelPreview();

  fightBtn.addEventListener('click', ()=>{
    if(duelState.fighting) return;
    const myStake = stakeCtl.getValue();
    if(myStake <= 0){ toast('Введите ставку', 'lose'); return; }
    if(myStake > state.balance){ toast('Недостаточно средств', 'lose'); return; }
    startDuel(myStake, opponent, {meSide, botSide, barMe, barBot, duelArena, fightBtn, resultEl}, ()=>{
      opponent = generateDuelOpponent();
      updateDuelPreview();
    });
  });

  c.appendChild(body);
  injectDuelStylesOnce();
  return c;
}

function generateDuelOpponent(){
  const names = ['ShadowBet','GoldRush99','NeonKing','ViperStake','LuckyFox','MaxWinner','DarkHorse','StormRider'];
  return {
    name: names[Math.floor(Math.random()*names.length)],
    stake: Math.round(100 + Math.random()*Math.random()*2000)
  };
}

function startDuel(myStake, opponent, refs, onDone){
  duelState.fighting = true;
  state.balance -= myStake;
  saveState();
  refs.fightBtn.disabled = true;
  refs.fightBtn.textContent = '⚔️ Бой идёт...';
  refs.resultEl.className = 'crash-result';
  refs.resultEl.textContent = '';
  refs.duelArena.classList.remove('won','lost'); // на случай если предыдущая анимация ещё не успела очиститься
  refs.duelArena.classList.add('clashing');

  const total = myStake + opponent.stake;
  const iWon = Math.random() < (myStake/total);

  setTimeout(()=>{
    refs.duelArena.classList.remove('clashing');
    refs.duelArena.classList.add(iWon ? 'won':'lost');
    const payout = iWon ? total : 0;

    vibrate(iWon ? [20,20,20] : [40,30,60]);
    if(iWon) playWinChime();
    recordBet('duel', myStake, payout);

    refs.resultEl.className = 'crash-result ' + (iWon?'win':'lose');
    refs.resultEl.textContent = iWon
      ? `🏆 Победа над ${opponent.name}! Выигрыш +${formatNum(total - myStake)} ₲`
      : `😔 Проиграл ${opponent.name}. Проигрыш ${formatNum(myStake)} ₲`;

    duelState.fighting = false;
    refs.fightBtn.disabled = false;
    refs.fightBtn.textContent = '⚔️ Ещё раз';
    setTimeout(()=> refs.duelArena.classList.remove('won','lost'), 1200);
    onDone();
  }, 1500);
}

