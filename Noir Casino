  const track = el('div', {class:'toggle-track' + (value ? ' on' : '')});
  const knob = el('div', {class:'toggle-knob'});
  track.appendChild(knob);
  track.addEventListener('click', ()=>{
    value = !value;
    track.classList.toggle('on', value);
    onChange(value);
  });
  row.appendChild(track);
  return row;
}

