  const stakePanel = el('div', {class:'stake-panel'});
  stakePanel.appendChild(el('div', {class:'stake-label'}, ['Твоя ставка']));
  const stakeCtl = stakeControl(200, ()=> updateDuelPreview());
  stakePanel.appendChild(stakeCtl);
