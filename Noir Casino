  const colorRow = el('div', {class:'roulette-color-row'});
  const spinBtn = el('button', {class:'btn btn-primary btn-block', style:'margin-top:14px;'}, ['🎡 Крутить']);
  const resultEl = el('div', {class:'crash-result', id:'rouletteResult'});

  let selectedColor = null;
  const colorBtns = {};
  [
    {id:'red', label:'Красное', mult:'x3', cls:'red'},
    {id:'black', label:'Чёрное', mult:'x3', cls:'black'},
    {id:'green', label:'Зелёное', mult:'x34', cls:'green'},
  ].forEach(cfg=>{
    const b = el('button', {class:`roulette-color-btn ${cfg.cls}`, onclick:()=>{
      selectedColor = cfg.id;
      Object.values(colorBtns).forEach(x=>x.classList.remove('selected'));
      b.classList.add('selected');
    }}, [
      el('div', {class:'rcb-label'}, [cfg.label]),
