/* =========================================================
   3) БАШНЯ (Tower)
   Уровни, каждый уровень выбор из N ячеек, 1 из них — ловушка.
   Множители: 1.05x -> 1.31x -> 1.70x -> далее по нарастающей.
   ========================================================= */
let towerState = null;
const TOWER_LEVELS = 22;
const TOWER_COLS = 4; // на каждом уровне 4 ячейки, 1 ловушка

function renderTowerGame(){
  injectGameSharedStylesOnce();
  const c = el('div', {});
  c.appendChild(gameHeader('Башня', 'Поднимайся, избегая ловушек'));

  const body = el('div', {class:'game-body'});
  body.appendChild(towerSetupView(body));

  c.appendChild(body);
  injectTowerStylesOnce();
  return c;
}

function towerSetupView(body){
  const wrap = el('div', {id:'towerSetupWrap'});
  wrap.appendChild(el('div', {class:'odds-badge'}, [`🎯 ${TOWER_LEVELS} уровней · на каждом 1 ловушка из ${TOWER_COLS}`]));

  const stakePanel = el('div', {class:'stake-panel'});
  stakePanel.appendChild(el('div', {class:'stake-label'}, ['Ставка']));
  const stakeCtl = stakeControl(100, ()=>{});
  stakePanel.appendChild(stakeCtl);
  wrap.appendChild(stakePanel);

  wrap.appendChild(el('button', {class:'btn btn-primary btn-block', onclick:()=>{
    const stake = stakeCtl.getValue();
    if(stake <= 0){ toast('Введите ставку', 'lose'); return; }
    if(stake > state.balance){ toast('Недостаточно средств', 'lose'); return; }
    startTower(stake, body);
  }}, ['🗼 Начать подъём']));

  return wrap;
}

function buildTowerMultipliers(levels, cols){
  // Первые 3 уровня фиксированы по запросу: 1.05x, 1.31x, 1.70x.
  // Дальше — честная формула от реальной вероятности пройти N уровней подряд
  // (шанс пройти 1 уровень = (cols-1)/cols), с домашним эджем ~8% (RTP ~92%),
  // согласовано с остальными играми.
  const fixed = [1.05, 1.31, 1.70];
  const houseEdgeRTP = 0.92;
  const safeChancePerLevel = (cols - 1) / cols;

  const MULT_CAP = 500;
  const mults = [];
  for(let level = 1; level <= levels; level++){
    if(level <= fixed.length){
      mults.push(fixed[level-1]);
    } else {
      const probReach = Math.pow(safeChancePerLevel, level);
      const fairMult = houseEdgeRTP / probReach;
      const prev = mults[mults.length-1];
      const next = Math.max(prev, Math.round(fairMult * 100) / 100);
      mults.push(Math.min(next, MULT_CAP));
    }
  }
  return mults;
}

function startTower(stake, body){
  state.balance -= stake;
  saveState();

  const levels = [];
  for(let i=0; i<TOWER_LEVELS; i++){
    levels.push(Math.floor(Math.random() * TOWER_COLS)); // индекс ловушки
  }

  towerState = {
    stake,
    levels, // trap index per level
    currentLevel: 0,
    multipliers: buildTowerMultipliers(TOWER_LEVELS, TOWER_COLS),
    ended: false,
    picks: [] // выбранная ячейка на каждом пройденном уровне
  };

  renderTowerBoard(body);
}

function renderTowerBoard(body){
  body.innerHTML = '';
  const ts = towerState;

  body.appendChild(el('div', {class:'odds-badge'}, [`🎯 Уровень ${ts.currentLevel+1} из ${TOWER_LEVELS}`]));

  const currentMult = ts.currentLevel === 0 ? 1.00 : ts.multipliers[ts.currentLevel - 1];
  const nextMult = ts.multipliers[ts.currentLevel];
  const potentialPayout = ts.stake * currentMult;

  const topInfo = el('div', {class:'mines-topinfo'}, [
    el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['Ставка']),
      el('div', {class:'mines-info-value'}, [formatNum(ts.stake) + ' ₲'])
    ]),
    el('div', {class:'mines-info-box highlight'}, [
      el('div', {class:'mines-info-label'}, ['Множитель']),
      el('div', {class:'mines-info-value'}, ['x' + currentMult.toFixed(2)])
    ]),
    el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['Заберёте']),
      el('div', {class:'mines-info-value gold'}, [formatNum(potentialPayout) + ' ₲'])
    ]),
  ]);
  body.appendChild(topInfo);

  // Башня рисуется сверху вниз: верхние уровни выше по номеру
  const towerWrap = el('div', {class:'tower-wrap'});
  for(let lvl = TOWER_LEVELS - 1; lvl >= 0; lvl--){
    const isCurrent = lvl === ts.currentLevel && !ts.ended;
    const isPast = lvl < ts.currentLevel;
    const isFuture = lvl > ts.currentLevel;

    const rowEl = el('div', {class:'tower-row' + (isCurrent?' current':'') + (isFuture?' future':'')});
    rowEl.appendChild(el('div', {class:'tower-row-label'}, [
      `Ур. ${lvl+1}`,
      el('span', {class:'tower-row-mult'}, [' x' + ts.multipliers[lvl].toFixed(2)])
    ]));

    const cellsRow = el('div', {class:'tower-cells'});
    for(let col=0; col<TOWER_COLS; col++){
      let cellClass = 'tower-cell';
      let content = '';
      if(isPast){
        const wasPicked = ts.picks[lvl] === col;
        const wasTrap = ts.levels[lvl] === col;
        if(wasPicked){ cellClass += wasTrap ? ' trap-hit' : ' safe-passed'; content = wasTrap ? '💥' : '✓'; }
        else if(ts.ended && wasTrap){ cellClass += ' trap-reveal'; content='💥'; }
      } else if(isCurrent){
        cellClass += ' active';
      } else {
        cellClass += ' locked';
      }
      const cellBtn = el('button', {class:cellClass}, [content]);
      if(isCurrent && !ts.ended){
        cellBtn.addEventListener('click', ()=> handleTowerClick(col, body));
      } else {
        cellBtn.disabled = true;
      }
      cellsRow.appendChild(cellBtn);
    }
    rowEl.appendChild(cellsRow);
    towerWrap.appendChild(rowEl);
  }
  body.appendChild(towerWrap);

  const btnRow = el('div', {class:'mines-btnrow'});
  if(!ts.ended){
    const canCashout = ts.currentLevel > 0;
    btnRow.appendChild(el('button', {
      class:'btn btn-violet btn-block',
      disabled: !canCashout,
      onclick: ()=> cashoutTower(body)
    }, [canCashout ? `💰 Забрать ${formatNum(potentialPayout)} ₲` : '💰 Пройдите хотя бы 1 уровень']));
  } else {
    btnRow.appendChild(el('div', {class:'crash-result ' + (ts.won ? 'win' : 'lose'), style:'opacity:1;'}, [
      ts.won
        ? `✅ Забрано! Выигрыш +${formatNum(ts.payout - ts.stake)} ₲`
        : `💥 Ловушка! Проигрыш ${formatNum(ts.stake)} ₲`
    ]));
    btnRow.appendChild(el('button', {class:'btn btn-primary btn-block', style:'margin-top:10px;', onclick:()=>{
      towerState = null;
      body.innerHTML = '';
      body.appendChild(towerSetupView(body));
    }}, ['🎮 Играть снова']));
  }
  body.appendChild(btnRow);

  // автоскролл к текущему уровню
  requestAnimationFrame(()=>{
    const currentRow = towerWrap.querySelector('.tower-row.current');
    if(currentRow) currentRow.scrollIntoView({block:'center', behavior:'smooth'});
  });
}

function handleTowerClick(col, body){
  const ts = towerState;
  if(ts.ended) return;

  ts.picks[ts.currentLevel] = col;

  if(ts.levels[ts.currentLevel] === col){
    ts.ended = true;
    ts.won = false;
    vibrate([40,30,60]);
    recordBet('tower', ts.stake, 0);
    renderTowerBoard(body);
    return;
  }

  vibrate(15);
  ts.currentLevel++;

  if(ts.currentLevel === TOWER_LEVELS){
    ts.ended = true;
    ts.won = true;
    const mult = ts.multipliers[TOWER_LEVELS - 1];
    ts.payout = ts.stake * mult;
    recordBet('tower', ts.stake, ts.payout);
  }

  renderTowerBoard(body);
}

function cashoutTower(body){
  const ts = towerState;
  if(ts.ended || ts.currentLevel === 0) return;
  const mult = ts.multipliers[ts.currentLevel - 1];
  ts.payout = ts.stake * mult;
  ts.ended = true;
  ts.won = true;
  vibrate(25);
  recordBet('tower', ts.stake, ts.payout);
  renderTowerBoard(body);
}

