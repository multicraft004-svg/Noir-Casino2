  for(let i=0; i<count; i++){
    participants.push({
      name: shuffled[i % shuffled.length] + (i >= shuffled.length ? '_'+i : ''),
      stake: Math.round(80 + Math.random()*Math.random()*1400),
      cashoutTarget: Math.round((1.15 + Math.random()*3.5) * 100) / 100, // личная цель кешаута 1.15x-4.65x
      resolved: false
    });
  }
  return participants;
}

function renderCrashGroupList(container, participants){
  container.innerHTML = '';
  if(!participants || participants.length === 0){
    container.appendChild(el('div', {class:'crash-group-empty'}, ['Пока нет истории раундов']));
    return;
  }
  participants.forEach(p=>{
    const row = el('div', {class:'crash-group-row'});
    row.appendChild(el('div', {class:'crash-group-name'}, [p.name]));
    row.appendChild(el('div', {class:'crash-group-stake'}, [formatNum(p.stake) + ' ₲']));
    if(!p.resolved){
      row.appendChild(el('div', {class:'crash-group-status waiting'}, ['🎲 играет...']));
    } else if(p.won){
      row.appendChild(el('div', {class:'crash-group-status win'}, [`✅ x${p.cashoutTarget.toFixed(2)} +${formatNum(Math.round(p.stake*(p.cashoutTarget-1)))} ₲`]));
    } else {
      row.appendChild(el('div', {class:'crash-group-status lose'}, ['💥 не успел']));
    }
    container.appendChild(row);
  });
}

// Вызывается после того, как раунд завершился (взрыв или кешаут игрока) -
// честно резолвит каждого демо-участника по той же точке краша, что видел игрок
function resolveCrashGroupParticipants(groupList, participants, crashPoint){
  if(!participants) return;
  participants.forEach(p=>{
    p.resolved = true;
    p.won = p.cashoutTarget <= crashPoint;
  });
  renderCrashGroupList(groupList, participants);
}

