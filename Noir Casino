/* =========================================================
   СБЕРЕЖЕНИЯ
   Пассивный доход от текущего баланса, копится по факту реального времени
   (не по кликам), с потолком по ставке в час и по накоплению за 24 часа —
   не может заменить собой риск-игры, только небольшая добавка за ожидание.
   ========================================================= */
const INVESTMENT_RATE_PER_HOUR = 0.001; // 0.1% от баланса в час
const INVESTMENT_MAX_PER_HOUR = 40; // потолок начисления в час, не зависит от размера баланса
const INVESTMENT_MAX_HOURS = 24; // максимум часов накопления за раз

function getInvestmentAccrued(){
  if(!state.investmentLastCollectTs) return 0;
  const now = Date.now();
  const hoursElapsed = Math.min((now - state.investmentLastCollectTs) / 3600000, INVESTMENT_MAX_HOURS);
  const ratePerHour = Math.min(state.balance * INVESTMENT_RATE_PER_HOUR, INVESTMENT_MAX_PER_HOUR);
  return Math.round(ratePerHour * hoursElapsed * 100) / 100;
}

function collectInvestment(){
  const accrued = getInvestmentAccrued();
  if(accrued <= 0) return false;
  state.balance += accrued;
  state.investmentLastCollectTs = Date.now();
  saveState();
  toast(`+${formatNum(accrued)} ₲ от сбережений`, 'win');
  return true;
}

function openInvestment(){
  if(!state.investmentLastCollectTs) state.investmentLastCollectTs = Date.now();
  currentGame = '__investment__';
