/* =========================================================
   11) СЧАСТЛИВАЯ ПОКУПКА (Lucky Buy)
   Несколько демо-участников вносят ставки в общий приз, честный шанс
   пропорционален вкладу. Подано как открытие призового бокса, а не колесо.
   ========================================================= */
let luckyBuyState = { opening:false };

function renderLuckyBuyGame(){
  injectGameSharedStylesOnce();
  const c = el('div', {});
  c.appendChild(gameHeader('Счастливая покупка', 'Демо-приз · шанс = доля вклада в банк'));

  const body = el('div', {class:'game-body'});
  body.appendChild(el('div', {class:'odds-badge'}, ['🎯 Демо против ботов · честный шанс = твой вклад / общий приз']));
  body.appendChild(el('div', {class:'pvp-disclaimer'}, [
    'Это не реальные игроки — демонстрационные боты для показа механики. Выигрыш идёт в твой личный баланс.'
  ]));

  const boxWrap = el('div', {class:'lucky-box-wrap'});
  const box = el('div', {class:'lucky-box'}, ['🎁']);
  boxWrap.appendChild(box);
  body.appendChild(boxWrap);

  const poolInfo = el('div', {class:'mines-topinfo'});
  body.appendChild(poolInfo);

  const contributorsList = el('div', {class:'pvp-participants'});
  body.appendChild(contributorsList);

  const stakePanel = el('div', {class:'stake-panel'});
  stakePanel.appendChild(el('div', {class:'stake-label'}, ['Твой вклад']));
  const stakeCtl = stakeControl(200, ()=> updatePreview());
  stakePanel.appendChild(stakeCtl);
  body.appendChild(stakePanel);

  const openBtn = el('button', {class:'btn btn-primary btn-block'}, ['🎁 Открыть приз']);
  body.appendChild(openBtn);
  const resultEl = el('div', {class:'crash-result'});
  body.appendChild(resultEl);

  let contributors = generateLuckyBuyContributors();

  function updatePreview(){
    const myStake = stakeCtl.getValue();
    const total = contributors.reduce((s,c)=>s+c.stake,0) + myStake;

    poolInfo.innerHTML = '';
    poolInfo.appendChild(el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['Приз']),
      el('div', {class:'mines-info-value gold'}, [formatNum(total) + ' ₲'])
    ]));
    poolInfo.appendChild(el('div', {class:'mines-info-box highlight'}, [
      el('div', {class:'mines-info-label'}, ['Твой шанс']),
      el('div', {class:'mines-info-value'}, [((myStake/total)*100).toFixed(1) + '%'])
    ]));
    poolInfo.appendChild(el('div', {class:'mines-info-box'}, [
      el('div', {class:'mines-info-label'}, ['При победе']),
      el('div', {class:'mines-info-value gold'}, [formatNum(total) + ' ₲'])
    ]));

    contributorsList.innerHTML = '';
    const myColor = 'hsl(45, 90%, 62%)';
    const all = [...contributors.map(c=>({...c})), {name: state.nickname||'Вы', stake: myStake, color: myColor, isMe:true}];
    all.sort((a,b)=>b.stake-a.stake).forEach(p=>{
      const row = el('div', {class:'pvp-participant-row' + (p.isMe?' me':'')});
      row.appendChild(el('div', {class:'pvp-color-dot', style:`background:${p.color}; box-shadow: 0 0 8px ${p.color};`}));
      row.appendChild(el('div', {class:'pvp-participant-name'}, [p.isMe ? (state.nickname||'Вы') + ' (вы)' : p.name]));
      row.appendChild(el('div', {class:'pvp-participant-stake'}, [formatNum(p.stake) + ' ₲']));
      contributorsList.appendChild(row);
    });
  }
  updatePreview();

  openBtn.addEventListener('click', ()=>{
    if(luckyBuyState.opening) return;
    const myStake = stakeCtl.getValue();
    if(myStake <= 0){ toast('Введите вклад', 'lose'); return; }
    if(myStake > state.balance){ toast('Недостаточно средств', 'lose'); return; }
    openLuckyBuy(myStake, contributors, {box, boxWrap, openBtn, resultEl}, ()=>{
      contributors = generateLuckyBuyContributors();
      updatePreview();
    });
  });

  c.appendChild(body);
  injectLuckyBuyStylesOnce();
  return c;
}

function generateLuckyBuyContributors(){
  const names = ['IceCold_88','PhoenixBet','ThunderX','MysticWin','RapidFire','BlazeStake','FrostBite_','SilverBullet'];
  const count = 3 + Math.floor(Math.random()*4);
  const shuffled = [...names].sort(()=>Math.random()-0.5);
  const list = [];
  for(let i=0;i<count;i++){
    list.push({
      name: shuffled[i % shuffled.length] + (i >= shuffled.length ? '_'+i : ''),
      stake: Math.round(80 + Math.random()*Math.random()*1400),
      color: `hsl(${Math.floor(Math.random()*360)}, 75%, 58%)`
    });
  }
  return list;
}

function openLuckyBuy(myStake, contributors, refs, onDone){
  luckyBuyState.opening = true;
  state.balance -= myStake;
  saveState();
  refs.openBtn.disabled = true;
  refs.openBtn.textContent = '🎁 Открывается...';
  refs.resultEl.className = 'crash-result';
  refs.resultEl.textContent = '';
  refs.boxWrap.classList.remove('opened'); // на случай если предыдущая анимация ещё не успела очиститься
  refs.box.textContent = '🎁';
  refs.boxWrap.classList.add('shaking');

  const total = contributors.reduce((s,c)=>s+c.stake,0) + myStake;
  const iWon = Math.random() < (myStake/total);

  setTimeout(()=>{
    refs.boxWrap.classList.remove('shaking');
    refs.boxWrap.classList.add('opened');
    refs.box.textContent = iWon ? '🏆' : '📦';
    const payout = iWon ? total : 0;

    vibrate(iWon ? [20,20,20] : [40,30,60]);
    if(iWon) playWinChime();
    recordBet('luckybuy', myStake, payout);

    refs.resultEl.className = 'crash-result ' + (iWon?'win':'lose');
    refs.resultEl.textContent = iWon
      ? `🏆 Приз твой! Выигрыш +${formatNum(total - myStake)} ₲`
      : `😔 Приз не достался. Проигрыш ${formatNum(myStake)} ₲`;

    luckyBuyState.opening = false;
    refs.openBtn.disabled = false;
    refs.openBtn.textContent = '🎁 Открыть ещё раз';
    setTimeout(()=>{ refs.boxWrap.classList.remove('opened'); refs.box.textContent = '🎁'; }, 1600);
    onDone();
  }, 1400);
}

function injectLuckyBuyStylesOnce(){
  if(document.getElementById('luckyBuyStyles')) return;
  const s = document.createElement('style');
  s.id = 'luckyBuyStyles';
  s.textContent = `
    .lucky-box-wrap{
      display:flex; align-items:center; justify-content:center; height:140px; margin-bottom:14px;
    }
    .lucky-box{ font-size:64px; transition: transform .2s ease; filter: drop-shadow(0 6px 16px rgba(232,184,75,0.35)); }
    .lucky-box-wrap.shaking .lucky-box{ animation: boxShake .35s ease infinite; }
    @keyframes boxShake{ 0%,100%{transform: rotate(0deg) scale(1);} 25%{transform: rotate(-6deg) scale(1.03);} 75%{transform: rotate(6deg) scale(1.03);} }
    .lucky-box-wrap.opened .lucky-box{ animation: boxPop .4s cubic-bezier(0.34,1.56,0.64,1); }
    @keyframes boxPop{ 0%{transform:scale(0.6);} 60%{transform:scale(1.25);} 100%{transform:scale(1);} }
  `;
  document.head.appendChild(s);
}

/* =========================================================
   REGISTER GAME RENDERERS
   ========================================================= */
Object.assign(gameRenderers, {
  crash: renderCrashGame,
  tower: renderTowerGame,
  roulette: renderRouletteGame,
  dice: renderDiceGame,
  coinflip: renderCoinflipGame,
  pvp: renderPvpGame,
  safe: renderSafeGame,
  mines: renderMinesGame,
  keno: renderKenoGame,
  plinko: renderPlinkoGame,
  duel: renderDuelGame,
  luckybuy: renderLuckyBuyGame
});

// Сброс всех состояний игр при выходе на главный экран - останавливает
// фоновые requestAnimationFrame/setTimeout циклы (например, полёт ракеты
// в Крашь), которые иначе продолжали бы тихо работать в фоне после ухода
// с экрана игры, проверяя условие вида if(!crashState) return.
function resetAllGameStates(){
  crashState = null;
  minesState = null;
  towerState = null;
  safeState = null;
  kenoState = null;
  rouletteState = { spinning:false };
  diceState = { rolling:false, target: 50, mode: 'over' };
  coinflipState = { flipping:false };
  pvpState = { spinning:false };
  plinkoState = { dropping:false };
  duelState = { fighting:false };
  luckyBuyState = { opening:false };
}

