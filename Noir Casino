  const fightBtn = el('button', {class:'btn btn-primary btn-block'}, ['⚔️ Начать дуэль']);
  body.appendChild(fightBtn);
  const resultEl = el('div', {class:'crash-result'});
  body.appendChild(resultEl);

  function updateDuelPreview(){
    const myStake = stakeCtl.getValue();
    const total = myStake + opponent.stake;
    meSide.innerHTML = '';
    meSide.appendChild(el('div', {class:'duel-avatar'}, ['🧑']));
    meSide.appendChild(el('div', {class:'duel-name'}, [state.nickname || 'Вы']));
    meSide.appendChild(el('div', {class:'duel-stake'}, [formatNum(myStake) + ' ₲']));
