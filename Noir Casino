  spinBtn.addEventListener('click', ()=>{
    if(rouletteState.spinning) return;
    const stake = stakeCtl.getValue();
    if(!selectedColor){ toast('Выберите цвет ставки', 'lose'); return; }
    if(stake <= 0){ toast('Введите ставку', 'lose'); return; }
    if(stake > state.balance){ toast('Недостаточно средств', 'lose'); return; }
    spinRoulette(stake, selectedColor, {wheelTrack, spinBtn, resultEl});
  });

  c.appendChild(body);
  injectRouletteStylesOnce();
  return c;
}

function spinRoulette(stake, betColor, refs){
  rouletteState.spinning = true;
  state.balance -= stake;
  saveState();

  refs.spinBtn.disabled = true;
  refs.spinBtn.textContent = '🎡 Крутится...';
  refs.resultEl.className = 'crash-result';
  refs.resultEl.textContent = '';

  // Бонус шанса от Дерева талантов слегка смещает вероятность в пользу игрока:
  // с небольшой вероятностью (равной luckBonus) переигрываем спин один раз,
  // оставляя итог только если он оказался выигрышным для текущей ставки.
  const talentBonuses = getTalentBonuses();
  let winIndex = Math.floor(Math.random() * ROULETTE_NUMBERS.length);
  if(Math.random() < talentBonuses.luckBonus){
    const retryIndex = Math.floor(Math.random() * ROULETTE_NUMBERS.length);
    if(ROULETTE_NUMBERS[retryIndex].color === betColor) winIndex = retryIndex;
  }
  const winItem = ROULETTE_NUMBERS[winIndex];

  // Позиция в средней (второй) копии массива, чтобы крутилось "вперёд"
  const itemWidth = 76; // px, соответствует CSS
  const middleSetStart = ROULETTE_NUMBERS.length;
  const targetIndex = middleSetStart + winIndex;
  const randomOffset = (Math.random() - 0.5) * itemWidth * 0.6;
  const targetX = -(targetIndex * itemWidth) + (refs.wheelTrack.parentElement.offsetWidth/2) - itemWidth/2 + randomOffset;

  refs.wheelTrack.style.transition = 'none';
  refs.wheelTrack.style.transform = 'translateX(0px)';
  // форс рефлоу
  void refs.wheelTrack.offsetWidth;
  refs.wheelTrack.style.transition = 'transform 4.2s cubic-bezier(0.15, 0.85, 0.25, 1)';
  refs.wheelTrack.style.transform = `translateX(${targetX}px)`;

  setTimeout(()=>{
    rouletteState.spinning = false;
    const won = betColor === winItem.color;
    const talentBonuses = getTalentBonuses();
    // Базовые множители x2/x2/x34 остаются видимыми и честными для игрока;
    // бонус шанса от Дерева талантов слегка повышает вероятность выигрышного исхода
    // самого спина (учтено выше при выборе winIndex через luckBonus), выплата не меняется.
    const multMap = {red:2, black:2, green:34};
    const payout = won ? stake * multMap[betColor] : 0;

    vibrate(won ? 25 : [40,30,60]);
    recordBet('roulette', stake, payout);

    refs.resultEl.className = 'crash-result ' + (won?'win':'lose');
    const colorNames = {red:'Красное', black:'Чёрное', green:'Зелёное'};
    refs.resultEl.textContent = won
      ? `✅ Выпало ${winItem.n} (${colorNames[winItem.color]})! Выигрыш +${formatNum(payout - stake)} ₲`
      : `❌ Выпало ${winItem.n} (${colorNames[winItem.color]}). Проигрыш ${formatNum(stake)} ₲`;

    refs.spinBtn.disabled = false;
    refs.spinBtn.textContent = '🎡 Крутить ещё раз';
  }, 4300);
}

