// Промокоды, дающие очки талантов вместо монет — тематически "удача", помогают быстрее
// открыть улучшения в ветке "Удача" дерева талантов.
const PROMO_CODES_TALENTS = {
  'X2UDACHA': 5
};

function applyPromo(codeRaw){
  const code = (codeRaw||'').trim().toUpperCase();
  if(!code){ toast('Введите промокод', 'lose'); return; }
  if(state.usedPromoCodes.includes(code)){
    toast('Этот промокод уже использован', 'lose');
    return;
  }
  if(PROMO_CODES_TALENTS.hasOwnProperty(code)){
    const points = PROMO_CODES_TALENTS[code];
    state.talentPoints += points;
    state.usedPromoCodes.push(code);
    saveState();
    toast(`Промокод активирован: +${points} ⭐ очков талантов`, 'win');
    renderScreen();
  } else if(PROMO_CODES.hasOwnProperty(code)){
    const bonus = PROMO_CODES[code];
    state.balance += bonus;
    state.usedPromoCodes.push(code);
    saveState();
    toast(`Промокод активирован: +${bonus} ₲`, 'win');
    renderScreen();
  } else {
    toast('Промокод не найден', 'lose');
  }
}

function confirmReset(){
  if(confirm('Сбросить весь прогресс и баланс? Это действие необратимо.')){
    state = structuredClone(DEFAULT_STATE);
    saveState();
    toast('Прогресс сброшен');
    renderScreen();
  }
}

