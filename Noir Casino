function renderScreen(){
  screensEl.innerHTML = '';
  const wrap = document.createElement('div');
  wrap.className = 'screen active';

  if(currentGame === '__talent_tree__'){
    wrap.appendChild(renderTalentTreeScreen());
  } else if(currentGame === '__daily_bonus__'){
    wrap.appendChild(renderDailyBonusScreen());
  } else if(currentGame === '__achievements__'){
    wrap.appendChild(renderAchievementsScreen());
  } else if(currentGame === '__investment__'){
    wrap.appendChild(renderInvestmentScreen());
  } else if(currentGame){
    wrap.appendChild(gameRenderers[currentGame]());
  } else {
    wrap.appendChild(renderers[currentTab]());
  }

  screensEl.appendChild(wrap);
  renderBalance();
}

/* ============ EL HELPER ============ */
function el(tag, attrs, children){
  const e = document.createElement(tag);
  attrs = attrs || {};
  Object.keys(attrs).forEach(k=>{
    if(k === 'class') e.className = attrs[k];
    else if(k === 'html') e.innerHTML = attrs[k];
    else if(k.startsWith('on') && typeof attrs[k] === 'function') e.addEventListener(k.slice(2), attrs[k]);
    else if(k === 'disabled') e.disabled = !!attrs[k]; // прямое свойство, а не setAttribute:
    // setAttribute('disabled', false) всё равно ставит атрибут (со значением "false"),
    // а в HTML сам факт наличия атрибута disabled блокирует элемент независимо от значения —
    // из-за этого кнопки Забрать (кэшбек, задания, пополнение) оставались заблокированы навсегда
    else e.setAttribute(k, attrs[k]);
  });
  (children||[]).forEach(c=>{
    if(c == null) return;
    if(typeof c === 'string') e.appendChild(document.createTextNode(c));
    else e.appendChild(c);
  });
  return e;
}

