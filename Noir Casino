/* =========================================================
   9) ПЛИНКО (Plinko)
   Шарик падает через 8 рядов колышков в один из 9 карманов.
   3 уровня риска - таблицы множителей посчитаны от биномиального распределения
   и проверены симуляцией на 300000 раундов, RTP ~92%.
   ========================================================= */
let plinkoState = { dropping:false };

const PLINKO_ROWS = 8;
const PLINKO_RISK_LEVELS = [
  {id:'low', label:'Низкий', table:{0:3.28,1:2.05,2:1.28,3:0.8,4:0.5,5:0.8,6:1.28,7:2.05,8:3.28}},
  {id:'mid', label:'Средний', table:{0:9.68,1:3.72,2:1.43,3:0.55,4:0.21,5:0.55,6:1.43,7:3.72,8:9.68}},
  {id:'high', label:'Высокий', table:{0:24.23,1:5.38,2:1.2,3:0.27,4:0.06,5:0.27,6:1.2,7:5.38,8:24.23}},
];

function renderPlinkoGame(){
  injectGameSharedStylesOnce();
  const c = el('div', {});
  c.appendChild(gameHeader('Плинко', 'Шарик падает через колышки в карман'));

  const body = el('div', {class:'game-body'});
  let selectedRisk = PLINKO_RISK_LEVELS[0];

  body.appendChild(el('div', {class:'odds-badge', id:'plinkoOddsBadge'}, ['🎯 Честный RTP ~92% · таблица проверена симуляцией']));

  const boardWrap = el('div', {class:'plinko-board'});
  const pegRows = el('div', {class:'plinko-pegs'});
  for(let r=0; r<PLINKO_ROWS; r++){
    const rowEl = el('div', {class:'plinko-peg-row'});
    for(let p=0; p<=r; p++){
      rowEl.appendChild(el('div', {class:'plinko-peg'}));
    }
    pegRows.appendChild(rowEl);
  }
  boardWrap.appendChild(pegRows);
  const ball = el('div', {class:'plinko-ball'}, ['●']);
  boardWrap.appendChild(ball);
  body.appendChild(boardWrap);

  const bucketsRow = el('div', {class:'plinko-buckets'});
  function renderBuckets(){
    bucketsRow.innerHTML = '';
    for(let k=0; k<=PLINKO_ROWS; k++){
      bucketsRow.appendChild(el('div', {class:'plinko-bucket', id:'plinkoBucket'+k}, ['x'+selectedRisk.table[k].toFixed(2)]));
    }
  }
  renderBuckets();
  body.appendChild(bucketsRow);

  body.appendChild(el('div', {class:'stake-label', style:'margin:14px 2px 9px;'}, ['Уровень риска']));
  const riskRow = el('div', {class:'plinko-risk-row'});
  const riskBtns = {};
  PLINKO_RISK_LEVELS.forEach(risk=>{
    const btn = el('button', {class:'plinko-risk-btn' + (risk.id===selectedRisk.id?' selected':''), onclick:()=>{
      selectedRisk = risk;
      Object.values(riskBtns).forEach(b=>b.classList.remove('selected'));
      btn.classList.add('selected');
      renderBuckets();
    }}, [risk.label]);
    riskBtns[risk.id] = btn;
    riskRow.appendChild(btn);
  });
  body.appendChild(riskRow);

  const stakePanel = el('div', {class:'stake-panel'});
  stakePanel.appendChild(el('div', {class:'stake-label'}, ['Ставка']));
  const stakeCtl = stakeControl(100, ()=>{});
  stakePanel.appendChild(stakeCtl);
  body.appendChild(stakePanel);

  const dropBtn = el('button', {class:'btn btn-primary btn-block'}, ['⬇️ Бросить шарик']);
  body.appendChild(dropBtn);
  const resultEl = el('div', {class:'crash-result'});
  body.appendChild(resultEl);

  dropBtn.addEventListener('click', ()=>{
    if(plinkoState.dropping) return;
    const stake = stakeCtl.getValue();
    if(stake <= 0){ toast('Введите ставку', 'lose'); return; }
    if(stake > state.balance){ toast('Недостаточно средств', 'lose'); return; }
    dropPlinkoBall(stake, selectedRisk, {ball, boardWrap, dropBtn, resultEl});
  });

  c.appendChild(body);
  injectPlinkoStylesOnce();
  return c;
}

function dropPlinkoBall(stake, risk, refs){
  plinkoState.dropping = true;
  state.balance -= stake;
  saveState();
  refs.dropBtn.disabled = true;
  refs.dropBtn.textContent = '⬇️ Падает...';
  refs.resultEl.className = 'crash-result';
  refs.resultEl.textContent = '';

  // Честный результат: 8 монеток - число "вправо" определяет карман (биномиальное распределение)
  let rightCount = 0;
  for(let i=0; i<PLINKO_ROWS; i++){ if(Math.random() < 0.5) rightCount++; }
  const bucket = rightCount;

  const boardWidth = refs.boardWrap.offsetWidth || 300;
  const bucketWidth = boardWidth / (PLINKO_ROWS + 1);
  const targetX = bucketWidth * bucket + bucketWidth/2 - 8; // 8 = половина ширины шарика

  refs.ball.style.transition = 'none';
  refs.ball.style.left = (boardWidth/2 - 8) + 'px';
  refs.ball.style.top = '0px';
  void refs.ball.offsetWidth;
  refs.ball.style.transition = 'top 1.1s cubic-bezier(0.55, 0, 0.85, 0.2), left 1.1s cubic-bezier(0.35, 0.2, 0.4, 1)';
  refs.ball.style.top = (refs.boardWrap.offsetHeight - 20) + 'px';
  refs.ball.style.left = targetX + 'px';

  setTimeout(()=>{
    const mult = risk.table[bucket];
    const payout = stake * mult;
    const won = mult >= 1;

    vibrate(won ? 20 : [40,30,60]);
    recordBet('plinko', stake, payout);

    const bucketEl = document.getElementById('plinkoBucket'+bucket);
    if(bucketEl) bucketEl.classList.add('landed');

    refs.resultEl.className = 'crash-result ' + (mult>=1?'win':'lose');
    refs.resultEl.textContent = mult >= 1
      ? `✅ Карман x${mult.toFixed(2)}! Выигрыш +${formatNum(payout - stake)} ₲`
      : `❌ Карман x${mult.toFixed(2)}. Проигрыш ${formatNum(stake - payout)} ₲`;

    plinkoState.dropping = false;
    refs.dropBtn.disabled = false;
    refs.dropBtn.textContent = '⬇️ Бросить ещё раз';
    if(bucketEl) setTimeout(()=> bucketEl.classList.remove('landed'), 1500);
  }, 1200);
}

